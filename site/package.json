{
  "name": "maas-weekly-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-price-fragment.mjs && node scripts/render-price-ledger.mjs && python3 scripts/build-skill-package.py && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prebuild": "python3 ../pipeline/scripts/validate-archive.py && python3 ../pipeline/scripts/validate-price-archive.py",
    "build:skill": "python3 scripts/build-skill-package.py"
  },
  "dependencies": {
    "astro": "^7.2.10",
    "marked": "^18.0.11"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "fast-xml-parser": "^5.11.1"
  }
}
