---
import { logoFor } from '../lib/platforms';
import BrandMark from './BrandMark.astro';
import { homeOverview, highlightEntities } from '../lib/home-page';
import type { PlatformHighlight } from '../lib/home-page';
interface Props { highlights: PlatformHighlight[]; platformOrder: string[]; date?: string; updatedAt?: string }
const { highlights, platformOrder, date, updatedAt } = Astro.props;
const { labels, picks, recentChanges } = homeOverview(highlights);

---
<header class="home-opening">
  <div class="opening-copy" data-highlight-carousel role="region" aria-roledescription="轮播" aria-label="今日重点">
    <div class="opening-kicker-row"><p class="home-kicker">MAAS DAILY / 今日重点</p>{picks.length > 1 && <button class="carousel-play" type="button" aria-label="暂停自动轮播">暂停</button>}</div>
    {picks.length > 0 && <h1 class="sr-only">MaaS Daily · 今日模型与平台变化</h1>}
    <div class="highlight-slides">{picks.map((item,index)=><article class="highlight-slide" data-highlight-slide hidden={index !== 0} role="group" aria-roledescription="幻灯片" aria-label={`${index+1} / ${picks.length}`}>
      <h2 class="highlight-title">{item.platform} · {item.headline}</h2><p class="opening-deck">{item.platform} · {labels[item.type] ?? labels.other}</p><p class="highlight-summary">{item.text}</p><div class="opening-links"><a href={`#signal-${platformOrder.indexOf(item.platform)}`}>查看记录与依据 ↗</a><a href="#market-title">查看各家近期变化 ↓</a></div>
    </article>)}</div>
    {!picks.length && <h1 id="opening-title">模型与平台，今日观察。</h1>}
    {picks.length > 1 && <div class="carousel-controls"><button type="button" data-carousel-prev aria-label="上一条重点">←</button><div class="carousel-pages" role="group" aria-label="选择重点">{picks.map((item,index)=><button type="button" data-carousel-page={index} aria-pressed={index === 0 ? 'true' : 'false'} aria-label={`第 ${index+1} 条：${item.headline}`}>{String(index+1).padStart(2,'0')}</button>)}</div><button type="button" data-carousel-next aria-label="下一条重点">→</button><span class="carousel-status" aria-live="polite">1 / {picks.length}</span></div>}
    <div class="opening-meta"><time datetime={date}>{date?.replaceAll('-','.') ?? '等待更新'}</time><span>官方来源追踪 · AI 摘要</span><a href="#digest">全部动态 ↗</a></div>
  </div>
  <div class="opening-brand"><div class="opening-mark"><BrandMark /></div><span class="opening-wordmark">MaaS Daily</span>{updatedAt && <div class="brand-update"><span>最近更新</span><time datetime={updatedAt}>{updatedAt}</time></div>}</div>
</header>
<section class="market-section vendor-changes" aria-labelledby="market-title" data-latest-date={recentChanges.to}>
  <div class="market-heading"><h2 id="market-title">各家产品，最近发生了什么</h2><div class="edition"><time datetime={date}>{date?.replaceAll('-','.')}</time><button id="copy-brief" type="button">复制简报 ↗</button><span id="copy-status" role="status"></span></div></div>
  <p class="market-note" id="change-range-note">近 7 天 · {recentChanges.from} — {recentChanges.to} · 按厂家与平台汇总，重复摘要合并，保留最近记录。</p>
  <div class="range-switch" role="group" aria-label="动态时间范围"><button type="button" data-range="today" aria-pressed="false">今天</button><button type="button" data-range="week" aria-pressed="true">近 7 天</button></div>
  <div class="explore-bar" aria-label="动态筛选">
    <label class="search-field"><span aria-hidden="true">⌕</span><input id="signal-search" type="search" placeholder="搜索平台、模型或关键词…" aria-label="搜索厂家与产品变化"/><kbd>/</kbd></label>
    <label class="platform-select"><span class="sr-only">筛选平台</span><select id="platform-filter"><option value="">全部平台</option>{recentChanges.groups.map(({platform:p}) => <option value={p}>{p}</option>)}</select></label>
    <button id="following-filter" class="quiet-button" type="button" aria-pressed="false">只看关注</button>
  </div>
  <div class="workspace-tabs"><div class="type-filters" role="group" aria-label="要点类型">
    {[['all', '全部动态'], ['release', '新发布'], ['pricing', '价格变化'], ['sunset', '下线提醒']].map(([value, label]) => <button type="button" data-filter={value} aria-pressed={value === 'all'}>{label}</button>)}
    </div><a href="#week">本周回顾 ↗</a>
  </div>
  <p id="filter-status" class="filter-status" role="status" aria-live="polite"></p>
  <div id="filter-empty" class="filter-empty" hidden><strong>没有找到匹配的动态</strong><p>试试其他关键词，或关注下方平台后再使用「只看关注」。</p><button type="button" id="reset-filters">重置筛选</button></div>

  <div id="digest">
  {recentChanges.groups.map(group => <article class="vendor-change-row" data-recent-platform={group.platform} data-platform={group.platform}>
    <header class="vendor-change-identity"><img src={logoFor(group.platform)} alt="" width="32" height="32" loading="lazy" /><div><h3>{group.platform}</h3><p>{group.items.length} 条变化 · 最近 {group.items[0].date.slice(5).replace('-','.')}</p></div><button class="follow-button" type="button" data-follow={group.platform} aria-pressed="false" aria-label={`关注 ${group.platform}`}>＋ 关注</button></header>
    <div class="vendor-change-body">
      <ul class="vendor-change-items">{group.items.map((item,index) => <li class="vendor-change-item" data-type={item.type} data-date={item.date} data-order={index}><span class={`change-kind kind-${item.type}`}>{labels[item.type] ?? labels.other}</span><p>{highlightEntities(item.text).map(seg => seg.hl ? <code>{seg.text}</code> : seg.text)}</p><a href={item.href} aria-label={`${group.platform} ${item.date} 的变化记录`}><time datetime={item.date}>{item.date.slice(5).replace('-','.')}</time> ↗</a></li>)}</ul>
      <details class="vendor-change-more" hidden><summary>展开更多变化</summary><ul class="vendor-change-items"></ul></details>

    </div>
  </article>)}
  {!recentChanges.groups.length && <p class="home-empty">近 7 天暂无已整理的厂家与产品变化。</p>}
  </div>
  <p class="market-note">查看日期记录可追溯当天摘要与官方来源。</p>
</section>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#signal-"]').forEach(link=>link.addEventListener('click',()=>{
    const drawer=document.querySelector<HTMLDetailsElement>('.source-drawer');if(drawer)drawer.open=true;
  }));
  const openFromHash=()=>{if(location.hash.startsWith('#signal-')){const drawer=document.querySelector<HTMLDetailsElement>('.source-drawer');if(drawer)drawer.open=true;}};
  openFromHash();window.addEventListener('hashchange',openFromHash);
</script>

<script src="../scripts/highlight-carousel.ts"></script>
