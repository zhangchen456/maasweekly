---
import Layout from '../layouts/Layout.astro';
const {locale='zh'}=Astro.props;
const en=locale==='en';const t=(zh:string,eng:string)=>en?eng:zh;
---
<Layout title={t('项目成本跟踪 — MaaS Daily','Project cost tracking — MaaS Daily')} description={t('保存项目月用量基线，跟踪价格变化对预计成本的影响。','Save monthly usage baselines and track price changes against estimated project costs.')} locale={locale} noindex={true}>
<main class="project-page" data-projects data-locale={locale}>
 <header><p class="eyebrow">PROJECT COST TRACKING</p><h1>{t('知道变化，也知道影响多少钱。','Track changes. Understand their cost.')}</h1><p>{t('按你填写的月用量估算。普通输入／输出计费，不含缓存、税费、包量和额外费用。','Estimates use your monthly usage assumptions. Standard input/output token charges only; cache, taxes, packages and extra fees are excluded.')}</p></header>
 <p id="project-status" role="status" aria-live="polite"></p>
 <section class="project-example" id="project-example"><div><span class="eyebrow">{t('完整示例 · 虚构价格','COMPLETE EXAMPLE · FICTIONAL PRICES')}</span><h2>{t('客服助手：预计月成本下降 ¥50','Support assistant: estimated monthly cost falls ¥50')}</h2><p>{t('每月输入1亿、输出2千万 Token。输入单价从¥2降至¥1.5／百万Token，输出仍为¥8。','100 million input and 20 million output tokens per month. Input price falls from ¥2 to ¥1.5 per million tokens; output remains ¥8.')}</p></div><div class="example-amount">¥360 <span>→</span> ¥310<small>{t('相对基线下降约13.9%，用量保持不变','About 13.9% below baseline, at unchanged usage')}</small></div></section>
 <div class="project-actions"><button id="project-login" type="button">{t('登录／注册','Sign in / Register')}</button><button id="project-new" type="button" hidden>{t('新建跟踪项目','New tracked project')}</button><a id="project-upgrade" href={en?'/en/subscription/':'/subscription/'}>{t('Plus：5个在用项目，每项目10条用量','Plus: 5 projects, up to 10 usage lines each')}</a></div>
 <section id="project-list-section" hidden><h2>{t('我的项目','My projects')}</h2><div id="project-list" class="project-grid"></div></section>
 <section id="project-editor" class="project-panel" hidden>
  <h2 id="project-editor-title">{t('建立项目基线','Create a project baseline')}</h2>
  <p>{t('只添加实际同时使用的模型。比较中的备选方案不会自动相加。每次保存用量或模型变更都会建立新基线，保留旧版本。','Add models actually used together. Comparison alternatives are not added automatically. Saving changed usage or models creates a new baseline and preserves earlier versions.')}</p>
  <div id="project-import" hidden><label for="project-import-choice">{t('从刚才的比较中选择实际方案','Select the actual configuration from your comparison')}</label><select id="project-import-choice"></select><button id="project-import-apply" type="button">{t('导入这一方案','Import this configuration')}</button></div>
  <form id="project-form"><div class="project-fields"><label>{t('项目名称','Project name')}<input id="project-name" maxlength="80" required /></label><label>{t('用量依据，可选','Usage note (optional)')}<input id="project-note" maxlength="300" placeholder={t('例如：按10月用量估算','For example: October usage estimate')} /></label><label>{t('展示币种','Display currency')}<select id="project-currency"><option value="CNY">CNY</option><option value="USD">USD</option></select></label><label>{t('固定估算汇率：1 USD = 多少 CNY','Fixed estimate: CNY per USD')}<input id="project-fx" type="number" min="0.01" max="1000" step="0.000001" value="7" required /></label></div>
  <p>{t('上下文区间是单次请求的条件，不是整个月累计用量。汇率随基线固定，不因汇率波动发送调价通知。','Context bands apply to individual requests, not monthly totals. FX stays fixed with the baseline and does not trigger price-change alerts.')}</p>
  <div id="project-lines"></div><button id="project-add-line" type="button">{t('添加实际用量条目','Add actual usage line')}</button>
  <div class="project-actions"><button id="project-preview" type="submit">{t('预览新基线','Preview baseline')}</button><button id="project-cancel" type="button">{t('取消','Cancel')}</button></div>
  </form>
  <div id="project-preview-result" hidden></div><button id="project-confirm" type="button" hidden>{t('确认保存并跟踪','Confirm baseline and track')}</button>
 </section>
 <section id="project-detail" class="project-panel" hidden></section>
</main>
</Layout>
<script>import '../scripts/projects';</script>
<style>
.project-page{max-width:1040px;margin:auto;padding:52px 0 80px}.project-page header{max-width:780px;margin-bottom:30px}.project-page h1{font-size:clamp(28px,4vw,42px);line-height:1.35}.project-page p{color:var(--muted);line-height:1.8}.project-page button,.project-page input,.project-page select{font:inherit}.project-page button{padding:10px 16px;border:1px solid var(--line-strong);border-radius:6px;background:var(--panel-solid);color:var(--paper);cursor:pointer}.project-page button:disabled{opacity:.5;cursor:wait}.project-page input,.project-page select{width:100%;box-sizing:border-box;padding:10px;border:1px solid var(--line-strong);border-radius:6px;background:var(--panel-solid);color:var(--paper)}.project-page label{display:grid;gap:8px;font-size:13px}.project-example,.project-panel{border:1px solid var(--line-strong);border-radius:12px;padding:24px;margin:24px 0;background:var(--panel-solid)}.project-example{display:grid;grid-template-columns:1.7fr 1fr;gap:30px}.example-amount{font-size:32px;color:var(--acid);align-self:center;font-variant-numeric:tabular-nums}.example-amount span{color:var(--muted)}.example-amount small{display:block;font-size:12px;color:var(--muted);margin-top:10px}.project-actions{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:22px 0}.project-actions a{font-size:13px}.project-fields{display:grid;grid-template-columns:1fr 1fr;gap:20px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}#project-status{min-height:24px}#project-new,#project-preview,#project-confirm{background:var(--acid);color:var(--ink)}.project-page [hidden]{display:none!important}.project-page :focus-visible{outline:2px solid var(--acid);outline-offset:3px}@media(max-width:700px){.project-grid,.project-fields,.project-example{grid-template-columns:1fr}.project-panel,.project-example{padding:18px}.project-page{padding-top:28px}}
</style>
<style is:global>
.project-page button{padding:10px 16px;border:1px solid var(--line-strong);border-radius:6px;background:var(--panel-solid);color:var(--paper);font:inherit;cursor:pointer}.project-page button:hover{background:var(--acid-dim)}.project-page button:disabled{opacity:.5;cursor:wait}.project-page label{display:grid;gap:8px;font-size:13px}.project-page input,.project-page select{width:100%;min-width:0;box-sizing:border-box;padding:10px;border:1px solid var(--line-strong);border-radius:6px;background:var(--panel-solid);color:var(--paper);font:inherit}.project-page .project-actions{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin:22px 0}.project-page :focus-visible{outline:2px solid var(--acid);outline-offset:3px}

.project-card{padding:22px;border:1px solid var(--line-strong);border-radius:10px;background:var(--panel-solid)}.project-card h3{margin:0 0 14px;overflow-wrap:anywhere}.project-card strong{font-size:26px;font-variant-numeric:tabular-nums}.project-line{margin:18px 0;padding:18px;border:1px solid var(--line);border-radius:8px;display:grid;grid-template-columns:1fr 1fr;gap:16px}.project-line .project-quote{grid-column:1/-1}.project-history{border-top:1px solid var(--line);padding:16px 0;overflow-wrap:anywhere}.project-detail-line{border-bottom:1px solid var(--line);padding:16px 0}.project-detail-line a{margin-right:12px}.project-detail-line small{display:block;color:var(--muted);margin:8px 0}.project-private-note{font-size:12px;color:var(--muted)}@media(max-width:700px){.project-line{grid-template-columns:1fr}}
</style>
