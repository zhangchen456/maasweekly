---
// 榜单区块壳：统一头部（标题/快照/徽标）+ 脚注（口径 note + 溯源链接）+ slot 数据体。
interface Props {
  id: string;
  title: string;
  snap: string;
  manual?: boolean;
  cycle?: string;
  note: string;
  sourceUrl: string;
  citation?: string;
}
const { id, title, snap, manual, cycle, note, sourceUrl, citation } = Astro.props;
const CYCLE_LABEL: Record<string, string> = { daily: '日更', weekly: '周更', monthly: '月更' };
---

<section class="board" id={id} aria-label={title}>
  <header class="board-head">
    <h3>{title}</h3>
    <span class="board-meta">
      <span class="snap">快照 {snap}</span>
      {manual && <span class="badge badge-manual">手动维护</span>}
      {cycle && <span class="badge badge-cycle">{CYCLE_LABEL[cycle] ?? cycle}</span>}
    </span>
  </header>
  <div class="board-content"><slot /></div>
  <div class="board-foot">
    <details class="board-method"><summary>数据口径与更新说明 <span>＋</span></summary><p class="board-note">{note}</p>{manual && <p class="board-note">该榜单由人工维护，数据截至 {snap}。</p>}</details>
    <a class="board-source" href={sourceUrl} target="_blank" rel="noopener">查看原始榜单 ↗</a>
    {citation && <p class="board-cite">{citation}</p>}
  </div>
</section>
