---
import EvidenceLinks from './EvidenceLinks.astro';
import { englishPriceCells, englishPriceHeaders } from '../lib/price-display';
import type { PriceRecord } from '../lib/release';
import { modelIndex } from '../lib/model-pages';
const { prices } = Astro.props as { prices: PriceRecord[] };
const catalog = modelIndex().models;
---
<div class="table-scroll"><table class="price-table">
  <thead><tr>{englishPriceHeaders.map(label => <th scope="col">{label}</th>)}<th scope="col">Evidence / record</th></tr></thead>
  <tbody>{prices.map(price => <tr data-price-id={price.id} data-model-id={price.modelId ?? ''} data-family-id={catalog.get(price.modelId ?? '')?.familyId ?? ''} data-provider={price.providerId} data-component={price.component} data-currency={price.currency} data-quality={price.quality.state} data-search={`${price.modelKey} ${price.modelId ?? ''}`.toLowerCase()}>
    {englishPriceCells(price).map(value => <td>{value}</td>)}
    <td><EvidenceLinks price={price} locale="en" /></td>
  </tr>)}</tbody>
</table></div>
<style is:global>
  .table-scroll {overflow:auto;max-width:100%;margin:20px 0}
  .price-table {border-collapse:collapse;font-size:12px;width:100%}
  .price-table th,.price-table td {padding:12px 10px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top;min-width:100px}
  .price-table th {color:var(--muted)}
  .price-table a {color:var(--cyan)}
</style>
