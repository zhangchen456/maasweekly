  <path class="mark-trace" d="M14 66V24L40 51L66 24V66" fill="none" stroke="currentColor" stroke-width="9" stroke-linejoin="round" stroke-linecap="round" pathLength="1"/>
  <g class="mark-dot"><circle class="mark-ring" cx="66" cy="66" r="9" fill="none" stroke="var(--acid)" stroke-width="1.2"/><path class="mark-tick" d="M66 57A9 9 0 0 1 75 66" fill="none" stroke="var(--acid)" stroke-width="1.8" stroke-linecap="round"/><circle cx="66" cy="66" r="6" fill="var(--acid)"/><circle cx="66" cy="66" r="2" fill="#B5F2DD"/></g>
