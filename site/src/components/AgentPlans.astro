---
const {en=false}=Astro.props;
const text=(zh:string,english:string)=>en?english:zh;
---
<section class="agent-plans" aria-label={text('选择接入版本','Choose access plan')}>
<button type="button" class="plan-card" data-access-plan="free" aria-pressed="true" aria-controls="access-methods">
<span class="plan-top"><span class="plan-label">Free</span><span class="selection">{text('已选择','Selected')}</span></span>
<span class="plan-title">{text('公开信息，直接连接','Public information, ready to connect')}</span>
<span class="plan-description">{text('平台变化、模型价格与证据查询；周报目录和摘要。','Platform changes, prices and evidence; weekly catalog and summaries.')}</span>
<span class="plan-note">{text('无需登录或凭证','No sign-in or credentials')}</span>
</button>
<button type="button" class="plan-card plus" id="plus-access" data-access-plan="plus" aria-pressed="false" aria-controls="access-methods">
<span class="plan-top"><span class="plan-label">Plus</span><span class="selection">{text('已选择','Selected')}</span></span>
<span class="plan-title">{text('会员全文与专业分析','Complete reports and professional analysis')}</span>
<span class="plan-description">{text('Free 全部内容，以及深度周报全文、已发布专业分析与个人简报。','Everything in Free, plus complete weekly reports, published analysis and personal reports.')}</span>
<span class="plan-note">{text('需要 Plus 权益和个人凭证 · 公测免费','Plus access and personal token required · Free beta')}</span>
</button>
</section>
<style>
.agent-plans{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;margin-bottom:32px}.plan-card{font:inherit;text-align:left;cursor:pointer;padding:24px;border:1px solid var(--line-strong);border-radius:12px;background:var(--panel);color:var(--paper);min-width:0}.plan-card:hover{border-color:var(--acid)}.plan-card[aria-pressed=true]{border-color:var(--acid);box-shadow:inset 0 0 0 1px var(--acid);background:var(--acid-dim)}.plan-card:focus-visible{outline:2px solid var(--acid);outline-offset:4px}.plan-top{display:flex;justify-content:space-between;align-items:center}.plan-label{font-size:11px;font-weight:700;background:var(--acid-dim);color:var(--acid);padding:4px 10px;border-radius:4px}.plus .plan-label{background:var(--acid);color:var(--ink)}.selection{font-size:12px;color:var(--acid);visibility:hidden}[aria-pressed=true] .selection{visibility:visible}.plan-title{display:block;font-size:22px;line-height:1.4;margin:16px 0 12px}.plan-description{display:block;font-size:13px;line-height:1.85;color:var(--paper-soft)}.plan-note{display:block;font-size:12px;color:var(--muted);margin-top:16px}@media(max-width:760px){.agent-plans{grid-template-columns:1fr}.plan-card{padding:20px}}
</style>
