---
import Layout from '../layouts/Layout.astro';
const {locale='zh'}=Astro.props;
const en=locale==='en';
const t=(zh:string,english:string)=>en?english:zh;
const features=[
 [t('公开价格、变化记录与来源','Public prices, changes and sources'),t('完整访问','Full access'),t('完整访问','Full access')],
 [t('模型关注与免费每日提醒','Model watchlist and daily alerts'),t('包含','Included'),t('包含','Included')],
 [t('重要变化详解','Reviewed change analysis'),t('公开样例','Public samples'),t('完整分析与影响说明','Full analysis and implications')],
 [t('历史与跨厂商专题对照','Historical and provider comparisons'),t('基础价格对比','Basic price comparisons'),t('条件、证据与局限说明','Conditions, evidence and limitations')],
 [t('个人专业简报','Personal professional briefings'),t('—','—'),t('按厂商、模型、系列和主题筛选','Filter by provider, model, family and topic')],
 [t('专业邮件与私有 RSS','Professional email and private RSS'),t('—','—'),t('独立订阅与退订','Separate opt-in and unsubscribe')],
 [t('Agent / MCP 接入','Agent / MCP access'),t('公开信息，匿名使用','Anonymous public information'),t('凭证访问专业内容','Credential access to professional content')],
 [t('专业内容导出','Professional content export'),t('—','—'),t('Markdown / CSV','Markdown / CSV')],
];
---
<Layout title={t('订阅 — MaaS Daily','Subscription — MaaS Daily')} description={t('比较 Free 与 Plus，选择适合你的信息订阅。','Compare Free and Plus information subscriptions.')} locale={locale}>
 <main class="subscription" data-subscription data-locale={locale}>
  <header class="subscription-intro"><p class="eyebrow">MAAS DAILY / MEMBERSHIP</p><h1>{t('从了解变化，到判断影响。','From tracking changes to understanding impact.')}</h1><p>{t('Free 看公开信息。Plus 提供经过审核的分析、专题对照和个人简报。','Free covers public information. Plus adds reviewed analysis, comparisons and personal briefings.')}</p></header>
  <div class="plan-grid">
   <article class="plan-card" data-plan="free"><div class="plan-top"><h2>Free</h2><span class="current-plan" data-current-free hidden>{t('当前套餐','Current plan')}</span></div><p class="plan-description">{t('日常浏览，持续关注。','Browse and keep track.')}</p><div class="plan-price"><strong>¥0</strong><span>{t('永久免费','Always free')}</span></div><a class="plan-action free-action" href={en?'/en/changes/':'/changes/'}>{t('继续使用 Free','Continue with Free')}</a><p class="action-note">{t('公开信息与现有免费功能保持开放。','Public information and existing free features remain available.')}</p><ul><li>{t('公开价格、计费条件与变化记录','Public prices, billing conditions and changes')}</li><li>{t('来源、历史记录与基础价格对比','Sources, historical records and basic comparisons')}</li><li>{t('模型关注、工作空间偏好与每日提醒','Watchlist, saved preferences and daily alerts')}</li><li>{t('匿名 Agent、MCP 与公共 RSS 接入','Anonymous Agent, MCP and public RSS access')}</li><li>{t('专业情报的公开样例','Public professional intelligence samples')}</li></ul></article>
   <article class="plan-card plus-card" data-plan="plus"><div class="plan-top"><h2>Plus</h2><span class="current-plan" data-current-plus hidden>{t('当前套餐','Current plan')}</span><span class="plus-label" data-plus-label>{t('专业情报','Professional intelligence')}</span></div><p class="plan-description">{t('为产品判断与技术决策准备。','For product and technical decisions.')}</p><div class="plan-price"><strong>US$9.90<span class="price-period">{t("／月", " / month")}</span></strong><span>{t("计划定价 · 公测期间免费体验", "Planned price · Free during public beta")}</span></div><button class="plan-action plus-action" id="subscription-plus" type="button">{t('免费开启 Plus','Enable Plus for free')}</button><p class="action-note" id="subscription-action-note">{t('无需支付方式。收费前另行通知，由你自主决定是否订阅。','No payment method required. You choose whether to subscribe when paid plans launch.')}</p><ul><li>{t('包含 Free 的全部功能','Everything in Free')}</li><li>{t('重要变化的完整分析、适用条件与证据','Full change analysis, conditions and evidence')}</li><li>{t('历史与跨厂商专题对照，标明可比条件','Historical and provider comparisons with explicit conditions')}</li><li>{t('按关注范围组合的个人专业简报','Personal briefings matched to your scope')}</li><li>{t('独立专业邮件、私有 RSS 与专业 MCP','Separate professional email, private RSS and professional MCP')}</li><li>{t('Markdown / CSV 导出与更正记录','Markdown / CSV exports and correction history')}</li></ul></article>
  </div>
  <p id="subscription-status" class="subscription-status" role="status" aria-live="polite">{t('正在查询当前套餐…','Checking your current plan…')}</p>
  <section class="comparison"><h2>{t('具体有什么不同','Compare the details')}</h2><div class="comparison-scroll"><table><thead><tr><th scope="col">{t('能力','Feature')}</th><th scope="col">Free</th><th scope="col">Plus</th></tr></thead><tbody>{features.map(([name,free,plus])=><tr><th scope="row">{name}</th><td>{free}</td><td>{plus}</td></tr>)}</tbody></table></div></section>
  <div class="subscription-notes"><p>{t('Plus 首版围绕信息分析与分发，不包含模型调用额度。专业内容目前以中文提供。','Plus focuses on information analysis and delivery. Model inference credits are not included. Professional content is currently in Chinese.')}</p><a href="/pro/">{t('查看专业情报与公开样例 →','View professional intelligence and public samples →')}</a></div>
 </main>
</Layout>
<script>import '../scripts/subscription';</script>
<style>
.subscription{max-width:980px;margin:auto;padding:64px 0 80px}.subscription-intro{text-align:center;max-width:760px;margin:0 auto 44px}.subscription-intro h1{font-size:clamp(30px,4vw,44px);line-height:1.3;letter-spacing:-.04em;text-wrap:balance}.subscription-intro p{line-height:1.8;color:var(--muted);font-size:15px}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.plan-card{padding:34px;border:1px solid var(--line-strong);border-radius:20px;background:var(--panel-solid)}.plus-card{border-color:var(--acid);background:linear-gradient(145deg,var(--acid-dim),transparent 70%),var(--panel-solid)}.plan-top{display:flex;align-items:center;gap:14px;min-height:40px}.plan-top h2{font-size:30px;margin:0;letter-spacing:-.03em}.current-plan,.plus-label{margin-left:auto;font-size:11px;padding:6px 9px;border-radius:5px;background:var(--acid-dim);color:var(--acid)}.plan-description{color:var(--muted);margin:12px 0 28px;font-size:14px}.plan-price{min-height:90px;display:flex;flex-direction:column;gap:6px}.plan-price strong{font-size:42px;line-height:1.3;font-variant-numeric:tabular-nums}.plan-price strong .price-period{font-size:15px;font-weight:400;margin-left:4px}.plan-price span{font-size:12px;color:var(--muted)}.plan-action{box-sizing:border-box;display:block;text-align:center;width:100%;padding:14px 18px;border-radius:8px;font:inherit;font-size:14px;font-weight:600;text-decoration:none;transition:background .2s,border-color .2s}.free-action{background:var(--ink-2);border:1px solid var(--line-strong);color:var(--paper)}.plus-action{background:var(--acid);border:1px solid var(--acid);color:var(--ink)}.plan-action:hover{filter:brightness(.94)}.plan-action:disabled{opacity:.6;cursor:wait}.action-note{min-height:35px;font-size:11px;color:var(--muted);line-height:1.6;margin:10px 0 20px}.plan-card ul{list-style:none;padding:0;margin:0}.plan-card li{position:relative;padding-left:22px;margin:18px 0;font-size:13px;line-height:1.7;color:var(--paper-soft)}.plan-card li::before{content:'✓';position:absolute;left:0;color:var(--acid)}.subscription-status{min-height:24px;text-align:center;color:var(--muted);font-size:12px;margin:22px 0}.comparison{margin-top:48px}.comparison h2,.application h2{font-size:23px}.comparison-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px;line-height:1.7}th,td{padding:17px 16px;text-align:left;border-bottom:1px solid var(--line)}thead th{font-size:14px}tbody th{font-weight:500;width:35%}td{color:var(--paper-soft)}.application{padding:28px;border:1px solid var(--line-strong);border-radius:12px;scroll-margin-top:150px}.application p,.subscription-notes{font-size:12px;color:var(--muted);line-height:1.9}.application label{display:block;margin:20px 0 8px;font-size:13px}.application textarea{box-sizing:border-box;width:100%;padding:12px;background:var(--ink);color:var(--paper);border:1px solid var(--line-strong);border-radius:7px;font:inherit;margin-bottom:16px}.application button{max-width:240px}.subscription-notes{margin-top:28px}.subscription-notes a{color:var(--acid)}@media(max-width:650px){.subscription{padding-top:36px}.plan-grid{grid-template-columns:1fr;gap:18px}.plan-card{padding:26px}.subscription-intro{margin-bottom:28px}.comparison th,.comparison td{padding:14px 9px;min-width:95px}.comparison tbody th{min-width:130px}.application{padding:22px}}
</style>
