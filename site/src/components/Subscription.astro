---
import {siteRuntime} from '../lib/runtime';
import Layout from '../layouts/Layout.astro';
const {locale='zh'}=Astro.props;
const en=locale==='en';
const t=(zh:string,english:string)=>en?english:zh;
const v2=Boolean(siteRuntime()?.membership?.());
const legacyFeatures=[
 [t('公开价格、变化记录与来源','Public prices, changes and sources'),t('完整访问','Full access'),t('完整访问','Full access')],
 [t('模型关注与免费每日提醒','Model watchlist and daily alerts'),t('包含','Included'),t('包含','Included')],
 [t('重要变化详解','Reviewed change analysis'),t('公开样例','Public samples'),t('完整分析与影响说明','Full analysis and implications')],
 [t('历史与跨厂商专题对照','Historical and provider comparisons'),t('基础价格对比','Basic price comparisons'),t('条件、证据与局限说明','Conditions, evidence and limitations')],
 [t('个人专业简报','Personal professional briefings'),t('—','—'),t('按厂商、模型、系列和主题筛选','Filter by provider, model, family and topic')],
 [t('专业邮件与私有 RSS','Professional email and private RSS'),t('—','—'),t('独立订阅与退订','Separate opt-in and unsubscribe')],
 [t('Agent / MCP 接入','Agent / MCP access'),t('公开信息，匿名使用','Anonymous public information'),t('凭证访问专业内容','Credential access to professional content')],
 [t('专业内容导出','Professional content export'),t('—','—'),t('Markdown / CSV','Markdown / CSV')],
];
const v2Features=[
 [t('当前报价、条件与单模型估算','Current prices, conditions and single-model estimates'),t('开放','Included'),t('开放','Included'),t('开放','Included')],
 [t('变化检索范围','Change history search'),t('最近7天','7 days'),t('最近30天','30 days'),t('全部可查询归档','All available history')],
 [t('自定义报价比较','Custom quote comparisons'),t('完整样例','Complete sample'),t('最多3个对象','Up to 3 quotes'),t('最多10个对象','Up to 10 quotes')],
 [t('模型关注','Model watchlist'),t('注册后使用','Register to use'),t('3个模型','3 models'),t('50个模型','50 models')],
 [t('变化邮件','Change email digest'),'—',t('每周一，有变化时发送','Weekly on Monday when changes exist'),t('每日，有变化时发送','Daily when changes exist')],
 [t('API / MCP 查询','API / MCP queries'),t('文档与样例','Docs and examples'),t('100次/月，账户凭证','100/month with account token'),t('3,000次/月，账户凭证','3,000/month with account token')],
 [t('项目用量基线与自动成本跟踪','Project baselines and automatic cost tracking'),t('完整示例','Complete example'),t('完整示例','Complete example'),t('5个项目，每项目10条用量','5 projects, 10 usage lines each')],
 [t('专业分析与个人简报','Analysis and personal briefings'),t('公开样例与预览','Samples and previews'),t('公开样例与预览','Samples and previews'),t('全文、范围筛选','Full text and scope filters')],
 [t('专业内容导出、私有RSS','Report export and private RSS'),'—','—','Markdown / CSV / RSS'],
];
const features=v2?v2Features:legacyFeatures;

---
<Layout title={t('订阅 — MaaS Daily','Subscription — MaaS Daily')} description={t('比较 Free 与 Plus，选择适合你的信息订阅。','Compare Free and Plus information subscriptions.')} locale={locale}>
 <main class="subscription" data-subscription data-locale={locale}>
  <header class="subscription-intro"><p class="eyebrow">MAAS DAILY / MEMBERSHIP</p><h1>{t('从了解变化，到判断影响。','From tracking changes to understanding impact.')}</h1><p>{v2?t('免费注册，保存比较并关注3个模型。Plus 提供每日跟踪、完整历史与专业分析。','Register free to save comparisons and follow 3 models. Plus adds daily tracking, full history and analysis.'):t('Free 看公开信息。Plus 提供经过审核的分析、专题对照和个人简报。','Free covers public information. Plus adds reviewed analysis, comparisons and personal briefings.')}</p></header>
  <p><a href="/subscription/payments/">{t("付费订阅与支付记录", "Paid subscription and payment history")}</a></p>
  <div class="plan-grid">
   <article class="plan-card" data-plan="free"><div class="plan-top"><h2>Free</h2><span class="current-plan" data-current-free hidden>{t('当前套餐','Current plan')}</span></div><p class="plan-description">{t('日常浏览，持续关注。','Browse and keep track.')}</p><div class="plan-price"><strong>¥0</strong><span>{t('永久免费','Always free')}</span></div><a class="plan-action free-action" href={v2?(en?'/en/account/':'/account/'):(en?'/en/changes/':'/changes/')}>{t('继续使用 Free','Continue with Free')}</a><p class="action-note">{v2?t('注册即可使用，无需付款。','Register free; no payment required.'):t('公开信息与现有免费功能保持开放。','Public information and existing free features remain available.')}</p>{v2?<ul><li>{t('3个模型关注与每周变化汇总','Follow 3 models with weekly change digests')}</li><li>{t('最近30天变化，最多3个报价方案比较','30-day history and comparisons of up to 3 quotes')}</li><li>{t('保存工作空间，API/MCP每月100次查询','Saved workspace and 100 API/MCP queries per month')}</li><li>{t('当前价格、来源与完整公开样例','Current prices, sources and complete public samples')}</li></ul>:<ul><li>{t('公开价格、计费条件与变化记录','Public prices, billing conditions and changes')}</li><li>{t('来源、历史记录与基础价格对比','Sources, historical records and basic comparisons')}</li><li>{t('模型关注、工作空间偏好与每日提醒','Watchlist, saved preferences and daily alerts')}</li><li>{t('匿名 Agent、MCP 与公共 RSS 接入','Anonymous Agent, MCP and public RSS access')}</li><li>{t('专业情报的公开样例','Public professional intelligence samples')}</li></ul>}</article>
   <article class="plan-card plus-card" data-plan="plus"><div class="plan-top"><h2>Plus</h2><span class="current-plan" data-current-plus hidden>{t('当前套餐','Current plan')}</span><span class="plus-label" data-plus-label>{t('专业情报','Professional intelligence')}</span></div><p class="plan-description">{t('为产品判断与技术决策准备。','For product and technical decisions.')}</p><div class="plan-price"><strong>US$9.99<span class="price-period">{t("／月", " / month")}</span></strong><span>{t("按月订阅 · 可取消续费", "Monthly subscription · Cancel future renewals")}</span></div><button class="plan-action plus-action" id="subscription-plus" type="button">{t('订阅 Plus','Subscribe to Plus')}</button><p class="action-note" id="subscription-action-note">{t('由你确认付款后开通。原公测用户保留 7 天过渡体验，不自动扣款。','Access starts after verified payment. Existing beta users have a 7-day transition; no automatic charge.')}</p>{v2?<ul><li>{t('5个项目的用量基线、自动成本重算与每日邮件','Usage baselines, automatic cost recalculation and daily email for 5 projects')}</li><li>{t('50个模型关注与每日变化汇总','Follow 50 models with daily change digests')}</li><li>{t('全部可查询历史，最多10个报价方案比较','All available history and comparisons of up to 10 quotes')}</li><li>{t('API/MCP每月3,000次查询','3,000 API/MCP queries per month')}</li><li>{t('专业分析全文、个人简报与Markdown/CSV导出','Full analysis, personal briefings and Markdown/CSV export')}</li><li>{t('专业邮件、私有RSS与专业MCP','Professional email, private RSS and professional MCP')}</li></ul>:<ul><li>{t('包含 Free 的全部功能','Everything in Free')}</li><li>{t('重要变化的完整分析、适用条件与证据','Full change analysis, conditions and evidence')}</li><li>{t('历史与跨厂商专题对照，标明可比条件','Historical and provider comparisons with explicit conditions')}</li><li>{t('按关注范围组合的个人专业简报','Personal briefings matched to your scope')}</li><li>{t('独立专业邮件、私有 RSS 与专业 MCP','Separate professional email, private RSS and professional MCP')}</li><li>{t('Markdown / CSV 导出与更正记录','Markdown / CSV exports and correction history')}</li></ul>}</article>
  </div>
  <p class="subscription-notes">{t('正式订阅规则：US$9.99/月，自动续费，可在线取消并在当期结束后停止续费。首次付款后7天内可申请全额退款，续费一般不退；法定退款权利不受影响。公测不会自动转为付费。', 'Paid subscription terms: US$9.99/month, automatically renewed until canceled online at the end of the current period. Request a full refund within 7 days of your first payment; renewals are generally non-refundable, subject to statutory rights. Free beta access does not automatically become paid.')} <a href="/terms/">{t('服务条款与退款规则', 'Terms and refund policy')}</a> · <a href="/privacy/">{t('隐私政策', 'Privacy policy')}</a></p>
  {v2&&<p class="subscription-notes">{t('API/MCP额度按北京时间自然月重置，所有凭证共享；初始化和失败查询不计入。包含普通输入／输出的项目成本跟踪；缓存计费、自定义阈值和团队协作暂未包含。','API/MCP allowances reset each calendar month in Asia/Shanghai and are shared across tokens. Initialization and failed queries do not count. Project tracking covers standard input/output token costs; cache billing, custom thresholds and team collaboration are not included.')}</p>}
  <p id="subscription-status" class="subscription-status" role="status" aria-live="polite">{t('正在查询当前套餐…','Checking your current plan…')}</p>
  <section class="comparison"><h2>{t('具体有什么不同','Compare the details')}</h2><div class="comparison-scroll"><table><thead><tr><th scope="col">{t('能力','Feature')}</th>{v2&&<th scope="col">{t('未登录','Visitor')}</th>}<th scope="col">Free</th><th scope="col">Plus</th></tr></thead><tbody>{features.map(([name,...values])=><tr><th scope="row">{name}</th>{values.map(value=><td>{value}</td>)}</tr>)}</tbody></table></div></section>
  <div class="subscription-notes"><p>{t('Plus 首版围绕信息分析与分发，不包含模型调用额度。周报支持中英文。','Plus focuses on information analysis and delivery. Model inference credits are not included. Weekly reports are available in Chinese and English.')}</p><a href="/pro/">{t('查看专业情报与公开样例 →','View professional intelligence and public samples →')}</a></div>
 </main>
</Layout>
<script>import '../scripts/subscription';</script>
<style>
.subscription{max-width:980px;margin:auto;padding:64px 0 80px}.subscription-intro{text-align:center;max-width:760px;margin:0 auto 44px}.subscription-intro h1{font-size:clamp(30px,4vw,44px);line-height:1.3;letter-spacing:-.04em;text-wrap:balance}.subscription-intro p{line-height:1.8;color:var(--muted);font-size:15px}.plan-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px}.plan-card{padding:34px;border:1px solid var(--line-strong);border-radius:20px;background:var(--panel-solid)}.plus-card{border-color:var(--acid);background:linear-gradient(145deg,var(--acid-dim),transparent 70%),var(--panel-solid)}.plan-top{display:flex;align-items:center;gap:14px;min-height:40px}.plan-top h2{font-size:30px;margin:0;letter-spacing:-.03em}.current-plan,.plus-label{margin-left:auto;font-size:11px;padding:6px 9px;border-radius:5px;background:var(--acid-dim);color:var(--acid)}.plan-description{color:var(--muted);margin:12px 0 28px;font-size:14px}.plan-price{min-height:90px;display:flex;flex-direction:column;gap:6px}.plan-price strong{font-size:42px;line-height:1.3;font-variant-numeric:tabular-nums}.plan-price strong .price-period{font-size:15px;font-weight:400;margin-left:4px}.plan-price span{font-size:12px;color:var(--muted)}.plan-action{box-sizing:border-box;display:block;text-align:center;width:100%;padding:14px 18px;border-radius:8px;font:inherit;font-size:14px;font-weight:600;text-decoration:none;transition:background .2s,border-color .2s}.free-action{background:var(--ink-2);border:1px solid var(--line-strong);color:var(--paper)}.plus-action{background:var(--acid);border:1px solid var(--acid);color:var(--ink)}.plan-action:hover{filter:brightness(.94)}.plan-action:disabled{opacity:.6;cursor:wait}.action-note{min-height:35px;font-size:11px;color:var(--muted);line-height:1.6;margin:10px 0 20px}.plan-card ul{list-style:none;padding:0;margin:0}.plan-card li{position:relative;padding-left:22px;margin:18px 0;font-size:13px;line-height:1.7;color:var(--paper-soft)}.plan-card li::before{content:'✓';position:absolute;left:0;color:var(--acid)}.subscription-status{min-height:24px;text-align:center;color:var(--muted);font-size:12px;margin:22px 0}.comparison{margin-top:48px}.comparison h2,.application h2{font-size:23px}.comparison-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;font-size:12px;line-height:1.7}th,td{padding:17px 16px;text-align:left;border-bottom:1px solid var(--line)}thead th{font-size:14px}tbody th{font-weight:500;width:35%}td{color:var(--paper-soft)}.application{padding:28px;border:1px solid var(--line-strong);border-radius:12px;scroll-margin-top:150px}.application p,.subscription-notes{font-size:12px;color:var(--muted);line-height:1.9}.application label{display:block;margin:20px 0 8px;font-size:13px}.application textarea{box-sizing:border-box;width:100%;padding:12px;background:var(--ink);color:var(--paper);border:1px solid var(--line-strong);border-radius:7px;font:inherit;margin-bottom:16px}.application button{max-width:240px}.subscription-notes{margin-top:28px}.subscription-notes a{color:var(--acid)}@media(max-width:650px){.subscription{padding-top:36px}.plan-grid{grid-template-columns:1fr;gap:18px}.plan-card{padding:26px}.subscription-intro{margin-bottom:28px}.comparison th,.comparison td{padding:14px 9px;min-width:95px}.comparison tbody th{min-width:130px}.application{padding:22px}}
</style>
