---
const { locale = 'zh' } = Astro.props;
const en = locale === 'en';
const t = (zh: string, english: string) => en ? english : zh;
---
<div class="account-access" data-account-access data-locale={locale}>
  <span id="account-sync-status" class="account-sync" role="status" aria-live="polite"></span>
  <button id="account-sync-retry" type="button" hidden>{t('重试保存', 'Retry save')}</button>
  <button id="account-login-open" class="account-login-button" type="button">{t('登录', 'Sign in')}</button>
  <details id="account-user-menu" class="account-user-menu" hidden>
    <summary aria-label={t('账户菜单', 'Account menu')}><span id="account-avatar" class="account-avatar"></span><span id="account-user-name"></span><span aria-hidden="true">⌄</span></summary>
    <div class="account-dropdown">
      <div class="account-identity"><strong id="account-menu-name"></strong><span id="account-menu-email"></span></div>
      <a href={en ? '/en/account/' : '/account/'}>{t('账户中心与我的关注', 'Account & watchlist')}</a>
      <button id="account-sign-out" type="button">{t('退出登录', 'Sign out')}</button>
      <p id="account-menu-status" role="status"></p>
    </div>
  </details>
</div>
<dialog id="account-login-dialog" class="account-login-dialog" aria-labelledby="account-login-title">
  <button id="account-login-close" class="account-dialog-close" type="button" aria-label={t('关闭登录', 'Close sign in')}>×</button>
  <p class="account-dialog-brand">MaaS Daily</p>
  <h2 id="account-login-title">{t('登录你的账户', 'Sign in to your account')}</h2>
  <p class="account-dialog-intro">{t('保存关注、价格对比和偏好，在不同设备上继续使用。', 'Keep your watchlist, price comparisons and preferences across devices.')}</p>
  <form id="account-global-login">
    <label for="account-login-email">{t('邮箱地址', 'Email address')}</label>
    <input id="account-login-email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com" />
    <div id="account-global-code-fields" hidden>
      <label for="account-login-code">{t('六位验证码', 'Six-digit code')}</label>
      <input id="account-login-code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" />
      <p class="account-code-hint">{t('验证码10分钟内有效。未收到时请检查垃圾邮件。', 'The code expires in 10 minutes. Check your spam folder if needed.')}</p>
    </div>
    <p id="account-login-feedback" class="account-feedback" role="status" aria-live="polite"></p>
    <button id="account-global-send" class="account-primary" type="button">{t('发送验证码', 'Send code')}</button>
    <button id="account-global-verify" class="account-primary" type="submit" hidden>{t('登录 / 创建账户', 'Sign in / Create account')}</button>
  </form>
  <p class="account-dialog-note">{t('首次登录自动创建账户，无需设置密码。', 'Your first sign-in creates an account. No password needed.')}</p>
</dialog>
<script>import '../scripts/account-access';</script>
<style is:global>
.account-access{display:flex;align-items:center;gap:10px;margin-left:auto;flex-shrink:0}.account-login-button,.account-user-menu summary{display:flex;align-items:center;gap:8px;border:1px solid var(--line-strong);background:var(--panel-solid);color:var(--paper);padding:8px 13px;border-radius:6px;cursor:pointer;font:inherit;font-size:12px;min-height:36px}.account-login-button:hover,.account-user-menu summary:hover{border-color:var(--cyan)}.account-user-menu{position:relative}.account-user-menu[hidden]{display:none}.account-user-menu summary{list-style:none;max-width:190px}.account-user-menu summary::-webkit-details-marker{display:none}#account-user-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:112px}.account-avatar{display:grid;place-items:center;width:22px;height:22px;background:var(--cyan);color:var(--ink);border-radius:5px;font-size:11px;font-weight:600}.account-dropdown{position:absolute;right:0;top:calc(100% + 10px);width:270px;padding:10px;background:var(--panel-solid);border:1px solid var(--line-strong);border-radius:8px;box-shadow:var(--shadow);z-index:25}.account-identity{padding:10px;border-bottom:1px solid var(--line);margin-bottom:6px}.account-identity strong,.account-identity span{display:block;overflow-wrap:anywhere}.account-identity span{font-size:11px;color:var(--muted);margin-top:5px}.account-dropdown a,.account-dropdown button{display:block;width:100%;text-align:left;padding:11px 10px;color:var(--paper);background:none;border:0;border-radius:4px;font:inherit;font-size:12px;text-decoration:none;cursor:pointer}.account-dropdown a:hover,.account-dropdown button:hover{background:var(--ink-2)}.account-dropdown p:empty{display:none}.account-dropdown p{font-size:11px;padding:0 10px;color:var(--red)}.account-sync{font-size:10px;color:var(--muted);white-space:nowrap}#account-sync-retry{border:0;background:none;color:var(--red);font:inherit;font-size:11px;cursor:pointer}#account-sync-retry[hidden]{display:none}.account-sync[data-error=true]{color:var(--red)}.account-login-dialog{width:min(440px,calc(100vw - 32px));padding:36px;border:1px solid var(--line-strong);border-radius:12px;background:var(--panel-solid);color:var(--paper);box-shadow:var(--shadow);max-height:calc(100dvh - 32px);overflow-y:auto}.account-login-dialog::backdrop{background:rgba(7,17,15,.55);backdrop-filter:blur(3px)}.account-dialog-close{position:absolute;right:15px;top:12px;background:none;border:0;color:var(--muted);font-size:25px;cursor:pointer;padding:5px}.account-dialog-brand{font-size:11px;color:var(--muted);margin:0 0 14px}.account-login-dialog h2{font-size:25px;letter-spacing:-.03em;margin:0 0 12px}.account-dialog-intro{font-size:13px;line-height:1.8;color:var(--paper-soft);margin-bottom:24px}.account-login-dialog label{display:block;font-size:12px;margin:16px 0 8px}.account-login-dialog input{box-sizing:border-box;width:100%;border:1px solid var(--line-strong);background:var(--ink);color:var(--paper);border-radius:5px;padding:13px;font:inherit}.account-login-dialog input[inputmode=numeric]{letter-spacing:.25em;font-size:20px}.account-primary{display:block;width:100%;padding:13px;border:0;border-radius:5px;background:var(--cyan);color:var(--ink);font:inherit;font-size:13px;cursor:pointer}.account-primary:disabled{opacity:.5;cursor:wait}.account-primary[hidden],#account-global-code-fields[hidden]{display:none}.account-feedback{font-size:12px;min-height:20px;color:var(--paper-soft)}.account-feedback[data-error=true]{color:var(--red)}.account-code-hint,.account-dialog-note{font-size:11px;line-height:1.8;color:var(--muted)}.account-dialog-note{margin:18px 0 0}.account-login-dialog :focus-visible,.account-access :focus-visible{outline:2px solid var(--cyan);outline-offset:3px}@media(max-width:600px){.topbar-inner{display:grid!important;grid-template-columns:1fr auto auto;gap:12px!important}.topbar-inner .brand{grid-column:1;grid-row:1}.topbar-inner .account-access{grid-column:2 / span 2;grid-row:1;justify-self:end}.topbar-inner .language-switch{grid-column:1 / span 2;grid-row:2}.topbar-inner .theme-toggle{grid-column:3;grid-row:2;justify-self:end}.topbar-inner .nav{grid-column:1 / -1;grid-row:3}.account-sync{display:none}.account-login-dialog{padding:28px}.account-access{gap:6px}.account-user-menu summary{padding:6px 9px;max-width:130px}#account-user-name{max-width:65px}}
</style>
