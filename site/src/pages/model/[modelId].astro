---
import BillingConditions from '../../components/BillingConditions.astro';
import EvidenceLinks from '../../components/EvidenceLinks.astro';
import ChangeList from '../../components/ChangeList.astro';
import { englishPriceCells, englishPriceHeaders, priceUnit } from '../../lib/price-display';
import Layout from '../../layouts/Layout.astro';
import ModelFollow from '../../components/ModelFollow.astro';
import { modelRelease, modelPage, priceCells, priceHeaders, providerLabels } from '../../lib/model-pages';
import { PUBLIC_ACCESS } from '../../config/public-access';

export function getStaticPaths() {
  return modelRelease().modelIdentities!.models.map(model => ({
    params: { modelId: model.modelId }, props: { page: modelPage(model.modelId) },
  }));
}
const { page } = Astro.props;
const { model, prices, changes, sources, keys, from, to, dataThrough, datasetVersion } = page;
const catalog = modelRelease().modelIdentities!;
const upstream = catalog.upstreamModels?.find(u => u.modelId === model.modelId);
const developer = catalog.developers?.find(d => d.developerId === upstream?.developerId);
const availability = catalog.availabilities?.filter(a => a.modelId === model.modelId) ?? [];
const platformName = (id: string) => catalog.platforms?.find(p => p.platformId === id)?.displayName ?? id;
const locale = Astro.url.pathname.startsWith('/en/') ? 'en' : 'zh';
const rows = prices.map(price => ({price, cells: (locale === 'en' ? englishPriceCells : priceCells)(price)}));
const providerId = model.modelId.split(':')[0];
const providerLabel = providerLabels[providerId] ?? providerId;
const hasContent = prices.length > 0 || changes.length > 0;
---
<Layout title={`${model.modelName} API 价格与价格变化 — MaaS Daily`}
  description={`查询 ${model.modelName} 的 API 报价、输入输出和缓存计费条件、原币种与单位、近期价格变化及证据。数据截至 ${dataThrough}。`}
  noindex={!hasContent}>
  <section class="model-hero">
    <div class="shell">
      <nav class="model-breadcrumb" aria-label="面包屑"><a href="/">首页</a> / <a href="/models/">模型 API 价格</a> / {model.modelName}</nav>
      <h1>{model.modelName} API 价格与变化</h1>
      <ModelFollow modelId={model.modelId} locale={locale} />
      <div class="model-meta">
        <span class="model-id">{model.modelId}</span>
        {model.familyId && <span class="model-family">系列：<a href={`/changes/?familyId=${model.familyId}`}>{model.familyName}</a></span>}
        <span class="model-provider">{providerLabel}</span>
      </div>
      <p class="muted small">数据截至 <time datetime={dataThrough}>{dataThrough}</time>。报价反映本站已接受的观察事实；生效时间、更新失败和不完整证据分别标注。</p>
    </div>
  </section>

  <div class="shell model-detail" data-locale={locale} data-price-layout="compact" data-model-id={model.modelId} data-api-base={PUBLIC_ACCESS.paths.apiBase}
    data-dataset-version={datasetVersion} data-from={from} data-to={to}>
    {upstream && <section class="model-section">
      <h2>开发者与调用平台</h2>
      <p>开发者：{developer?.displayName ?? upstream.developerId} · <a href={`/compare/#${model.modelId}`}>比较不同平台报价 →</a></p>
      <ul>{availability.map(a => <li><strong>{platformName(a.platformId)}</strong> · <code>{a.apiModelIds.join(' / ')}</code> · <a href={a.evidence.url} target="_blank" rel="noopener noreferrer">官方可用关系</a>（核验于 <time datetime={a.evidence.verifiedAt}>{a.evidence.verifiedAt}</time>）</li>)}</ul>
    </section>}
    <section class="model-section">
      <h2>API 模型名</h2>
      <p class="muted small">以下名称来自实际价格记录。调用时请核对对应平台的 API 文档。</p>
      <div id="model-keys" class="model-keys">{keys.length ? keys.map(key => <span class="model-key-tag">{key}</span>) : '当前数据中暂无可观察的 API 模型名。'}</div>
    </section>

    <section class="model-section">
      <div class="section-head"><h2>当前可观察的 API 价格</h2><button id="refresh-model" type="button">刷新数据</button></div>
      <p class="muted small">保留原币种和原始计费单位，不合并不同地区、档位、上下文或时间条件。条件字段为来源原值；“来源未单列”不代表没有限制。</p>
      <p id="refresh-status" class="muted small" role="status" aria-live="polite"></p>
      <div id="current-prices" class="current-prices">
        {prices.length ? <table class="price-table">
          <thead><tr><th scope="col">平台 / API 模型</th><th scope="col">计费项</th><th scope="col">价格 / 原始单位</th><th scope="col">条件与依据</th></tr></thead>
          <tbody>{rows.map(({price, cells}) => <tr data-price-id={price.id}>
            <td><strong>{cells[0]}</strong><small class="price-subline">{price.modelKey}</small></td>
            <td><span class="billing-badge">{cells[2]}</span></td>
            <td><strong class="detail-amount">{price.amount} <small>{price.currency}</small></strong><small class="price-subline">每 {priceUnit(price.unitQuantity, price.unitName)}</small></td>
            <td><BillingConditions headers={locale === 'en' ? englishPriceHeaders : priceHeaders} cells={cells} /><EvidenceLinks price={price} /></td>
          </tr>)}</tbody>
        </table> : <p class="empty-state">当前公开数据范围内暂无价格记录。不能据此判断该模型免费或平台未提供服务。</p>}
      </div>
      {sources.length > 0 && <div class="model-sources"><h3>官方定价来源</h3><ul>{sources.map(url => <li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>)}</ul></div>}
      <p class="muted small"><a href="/method/">数据方法与状态说明</a> · <a href="/pricing/">模型成本比较与 GPU 行情</a></p>
    </section>

    <section class="model-section">
      <div class="section-head"><h2>最近变化</h2><a class="section-link" href={`/changes/?modelId=${model.modelId}`}>浏览变化 →</a></div>
      <p class="muted small">{from} 至 {dataThrough} 的数据窗口，最多展示最近 10 条。没有记录不代表窗口之外没有变化。</p>
      <div id="recent-changes" class="recent-changes">
        <ChangeList changes={changes} />
      </div>
    </section>
  </div>
  <script src="../../scripts/model-refresh.ts"></script>
</Layout>
<style>
  .model-hero{padding:36px 0 20px}
  .model-hero h1{font-size:30px;margin:8px 0}
  .model-meta{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:13px;color:var(--muted)}
  .model-id{font-family:monospace;background:var(--panel-solid);padding:3px 10px;border-radius:6px;border:1px solid var(--line);font-size:12px}
  .model-family a{color:var(--cyan);text-decoration:none}
  .model-detail{padding:20px 0}
  .model-section{padding:20px 0;border-bottom:1px solid var(--line)}
  .model-section h2{font-size:18px;margin-bottom:10px}
  .section-head{display:flex;justify-content:space-between;align-items:center}
  .section-link{font-size:13px;color:var(--cyan);text-decoration:none}
  .section-link:hover{text-decoration:underline}
  .muted{color:var(--muted)}
  .small{font-size:12px}
  .model-keys{display:flex;gap:6px;flex-wrap:wrap;padding:8px 0}
  .model-detail :global(.model-key-tag){font-family:monospace;font-size:11px;background:var(--raised);border:1px solid var(--line);border-radius:6px;padding:2px 8px}
  .recent-changes,.current-prices{padding:8px 0}
  .model-detail :global(.change-card){padding:12px 0;border-bottom:1px solid var(--line)}
  .model-detail :global(.change-head){display:flex;gap:10px;font-size:12px;color:var(--muted);margin-bottom:4px}
  .model-detail :global(.change-type){padding:2px 8px;border-radius:6px;background:var(--acid-dim);font-size:11px}
  .model-detail :global(.change-title){display:block;font-weight:550;color:var(--paper);text-decoration:none;line-height:1.5}
  .model-detail :global(.change-title):hover{color:var(--cyan)}
  .model-detail :global(.change-summary){margin:4px 0 0;font-size:12px;color:var(--muted);line-height:1.6}
  .empty-state{padding:30px 0;text-align:center;color:var(--muted)}
  .current-prices{overflow-x:auto}
  .model-detail :global(.price-table){width:100%;border-collapse:collapse;font-size:12px}
  .model-detail :global(.price-table th){text-align:left;font-size:10px;color:var(--muted);padding:8px 10px;border-bottom:1px solid var(--line)}
  .model-detail :global(.price-table td){padding:8px 10px;border-bottom:1px solid var(--line)}
  .model-detail :global(.price-table td:first-child){font-family:monospace;font-size:11px}
  .model-detail :global(.price-table td){vertical-align:top;min-width:100px}
  .model-detail :global(.price-table a),.model-sources a,.model-breadcrumb a,.model-detail p a{color:var(--cyan)}
  .model-breadcrumb{font-size:12px;color:var(--muted);margin-bottom:16px}
  .model-sources{font-size:12px;overflow-wrap:anywhere}
  .model-sources h3{font-size:14px}
  #refresh-model{background:var(--panel-solid);border:1px solid var(--line);color:var(--paper);padding:7px 12px;border-radius:6px;cursor:pointer}
</style>
