---
import Layout from '../../layouts/Layout.astro';
const en=Astro.url.pathname.startsWith('/en/'),t=(zh:string,english:string)=>en?english:zh;
---
<Layout title={t('订阅与账单','Subscription and billing')} noindex={true}>
<main class="billing-page"><h1>{t('订阅与账单','Subscription and billing')}</h1><p>{t('Plus：US$9.99/月，自动续费。原公测用户保留 7 天过渡体验，不自动扣款。','Plus: US$9.99/month, renewed automatically. Existing beta users retain a 7-day transition with no automatic charge.')}</p><p id="billing-status" role="status"></p><button id="billing-login" hidden>{t('登录','Sign in')}</button><p id="billing-entitlement"></p><section><h2>{t('当前订阅','Current subscription')}</h2><div id="billing-subscriptions"></div></section><section><h2>{t('支付记录','Payment history')}</h2><div class="billing-scroll" id="billing-records"></div></section><p><label><input type="checkbox" id="billing-consent" />{t('我已阅读服务条款，同意每月 US$9.99 的自动续费（税费如适用以收银台为准），可随时取消后续续费。','I have read the terms and agree to US$9.99 monthly automatic renewal (plus any tax shown at checkout). I can cancel future renewals anytime.')}</label></p><button id="billing-buy" disabled>{t('前往 Waffo 付款','Continue to Waffo checkout')}</button><button id="billing-refresh">{t('核对付款结果','Check payment result')}</button><button id="billing-portal" disabled>{t('管理订阅与账单','Manage subscriptions and billing')}</button><p>{t('取消续费保留已付周期；付款结果以服务端核验为准。首次付款后 7 天内可申请全额退款，续费一般不退，法定权利不受影响。专业邮件需单独开启。','Cancellation preserves the paid period. Access requires verified payment. Full refunds may be requested within 7 days of the first payment; renewals are generally non-refundable, subject to statutory rights. Professional email requires separate opt-in.')}</p><p><a href="mailto:zhangchen3508@gmail.com?subject=MaaS%20Daily%20Refund">{t('申请退款（请附订单号）','Request a refund (include your order number)')}</a></p><p><a href={en?'/en/terms/':'/terms/'}>{t('服务条款与退款规则','Terms and refund policy')}</a> · <a href={en?'/en/subscription/':'/subscription/'}>{t('返回套餐','Back to plans')}</a></p></main>
</Layout>
<script>import '../../scripts/billing';</script>
<style>.billing-page{max-width:1080px;margin:3rem auto;padding:0 1rem}.billing-page article{border:1px solid #ddd;padding:1rem;margin:1rem 0}.billing-page button{margin:.4rem .6rem .4rem 0}.billing-scroll{overflow:auto}.billing-scroll :global(th),.billing-scroll :global(td){text-align:left;padding:.7rem;vertical-align:top;overflow-wrap:anywhere}.billing-scroll :global(table){width:100%;min-width:760px;border-collapse:collapse}</style>
