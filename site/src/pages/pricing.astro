---
import Layout from '../layouts/Layout.astro';
import '../styles/pricing.css';
import fs from 'node:fs';
import path from 'node:path';

function readJson(p) {
  try { return JSON.parse(fs.readFileSync(path.join(process.cwd(), p), 'utf-8')); }
  catch { return null; }
}

function readFile(p) {
  try { return fs.readFileSync(path.join(process.cwd(), p), 'utf-8'); }
  catch { return null; }
}

function priceRange(value) {
  const numbers = String(value).match(/[\d.]+/g)?.map(Number).filter(Number.isFinite) ?? [];
  return { low: numbers[0] ?? 0, high: numbers.at(-1) ?? numbers[0] ?? 0 };
}

const ledger = readJson('src/data/pricing/ledger.json');
const gpu = readJson('src/data/pricing/gpu.json');
const chips = readJson('src/data/pricing/chips.json');
const ledgerHtml = readFile('src/data/pricing/price-ledger.rendered.html');

const ledgerDate = ledger?.meta?.published_at
  ? new Date(ledger.meta.published_at * 1000).toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' }).replace(/\//g, '.')
  : '—';
const modelCount = new Set(ledger?.prices?.map((item) => `${item.provider}/${item.model}`) ?? []).size;
const providerCount = ledger?.providers?.length ?? 0;
const maxMonthly = Math.max(...(gpu?.gpu_list ?? []).map((item) => priceRange(item.monthly_cny).high), 1);
const gpuRows = (gpu?.gpu_list ?? []).map((item) => {
  const range = priceRange(item.monthly_cny);
  const start = range.low ? Math.sqrt(range.low / maxMonthly) * 100 : 0;
  const end = range.high ? Math.sqrt(range.high / maxMonthly) * 100 : 0;
  return { ...item, start, width: Math.max(end - start, range.high ? 2.2 : 0) };
});
const chipGroups = Object.values((chips?.chips ?? []).reduce((groups, item) => {
  groups[item.vendor] ??= { vendor: item.vendor, entries: [] };
  groups[item.vendor].entries.push(item);
  return groups;
}, {}));
---

<Layout title="价格与算力 — MaaS Daily" description="主流模型 API 定价、GPU 租赁行情与国产 AI 芯片动态">
  <div class="pricing-page">
    <header class="pricing-hero reveal">
      <div class="pricing-intro">
        <div class="pricing-kicker">COST &amp; COMPUTE / 价格观察</div>
        <h1>把模型成本，<br />放回算力全景里。</h1>
        <p>从一次 API 调用，到一张 GPU，再到国产芯片供给。三种价格尺度放在同一页，帮助你看清成本从哪里来。</p>
        <div class="pricing-status" aria-label="数据概况">
          <span><b>{providerCount}</b> 家 API 厂商</span>
          <span><b>{modelCount}</b> 个模型</span>
          <span>台账更新于 <b>{ledgerDate}</b></span>
        </div>
      </div>
      <nav class="pricing-index" aria-label="价格页面分区">
        <a href="#api-pricing"><span>01</span><strong>API 调用</strong><small>每百万 tokens</small><i>↘</i></a>
        <a href="#gpu-market"><span>02</span><strong>GPU 租赁</strong><small>时租与包月</small><i>↘</i></a>
        <a href="#chip-supply"><span>03</span><strong>国产芯片</strong><small>出货与进展</small><i>↘</i></a>
      </nav>
    </header>

    <section class="section pricing-section" id="api-pricing">
      <div class="section-heading">
        <span class="section-no">01 / API PRICING</span>
        <h2>模型 API 价格台账</h2>
        <p class="section-note">统一折算为人民币与每百万 tokens；可按厂商浏览、搜索模型，并把 2–5 个模型放入用量计算器比较。</p>
      </div>
      {ledgerHtml ? (
        <div class="ledger-embed" set:html={ledgerHtml} />
      ) : (
        <div class="pricing-empty">价格台账正在生成。数据抓取完成后，这里会自动显示最新报价。</div>
      )}
    </section>

    <section class="section pricing-section" id="gpu-market">
      <div class="section-heading">
        <span class="section-no">02 / GPU MARKET</span>
        <h2>GPU 算力租赁行情</h2>
        <p class="section-note">{gpu?.snapshot_date} 国内平台参考价。价格带按包月成本的平方根刻度展示，兼顾消费级与数据中心卡的量级差异。</p>
      </div>
      <div class="market-board reveal">
        <div class="market-scale" aria-hidden="true"><span>低</span><span>包月成本区间</span><span>高</span></div>
        <div class="market-list">
          {gpuRows.map((item) => (
            <article class="market-row">
              <div class="market-model"><strong>{item.gpu}</strong><span>{item.use}</span></div>
              <div class="market-prices">
                <span><small>时租</small>{item.hourly_cny === '—' ? '暂无' : `¥${item.hourly_cny}`}</span>
                <span><small>包月</small>{item.monthly_cny === '—' ? '暂无' : `¥${item.monthly_cny}`}</span>
              </div>
              <div class="market-range" aria-label={`${item.gpu} 包月参考 ${item.monthly_cny} 元`}>
                <i style={`--range-start:${item.start.toFixed(1)}%;--range-width:${item.width.toFixed(1)}%`}></i>
              </div>
              <div class="market-source">{item.source}</div>
            </article>
          ))}
        </div>
        <footer class="data-note"><span>口径</span><p>包月参考按 24/7 折算，价格随供需和机房配置波动，实际以平台实时报价为准。</p></footer>
      </div>
    </section>

    <section class="section pricing-section" id="chip-supply">
      <div class="section-heading">
        <span class="section-no">03 / CHIP SUPPLY</span>
        <h2>国产 AI 芯片进展</h2>
        <p class="section-note">{chips?.snapshot_date} 公开信息快照。按厂商归并关键经营与产品节点，避免把不同口径误读成同一排行榜。</p>
      </div>
      <div class="chip-board reveal">
        {chipGroups.map((group, groupIndex) => (
          <article class:list={["chip-group", { featured: groupIndex === 0 }]}>
            <header><span>{String(groupIndex + 1).padStart(2, '0')}</span><h3>{group.vendor}</h3><small>{group.entries.length} 项信号</small></header>
            <div class="chip-signals">
              {group.entries.map((item) => (
                <div class="chip-signal">
                  <div><span>{item.metric}</span><strong>{item.value}</strong></div>
                  <p>{item.note}</p>
                  <small>{item.source}</small>
                </div>
              ))}
            </div>
          </article>
        ))}
        <footer class="data-note"><span>说明</span><p>{chips?.note}</p></footer>
      </div>
    </section>
  </div>
</Layout>
