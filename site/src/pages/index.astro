---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';

// ===== 数据源 =====
// 每日动态（sync-diff-to-site.py + llm-digest.py 产出）
const dataPath = path.join(process.cwd(), 'src/data/daily_changes.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const days: any[] = data.days || [];
const today = days[0]; // 最新一天
const prevDay = days[1];

// 周聚合归档（sync-diff-to-site.py + llm-weekly-digest.py 产出）
const weeklyPath = path.join(process.cwd(), 'src/data/weekly-digest.json');
let weeks: any[] = [];
try { weeks = JSON.parse(fs.readFileSync(weeklyPath, 'utf-8')); } catch {}
const currentWeek = weeks[0]; // 当前/最近一周
const pastWeeks = weeks.slice(1); // 已完结周（归档列表）

// 周报（降级为归档入口）
const reports = await getCollection('weekly', ({ data }) => data.date <= new Date().toISOString().slice(0, 10));
reports.sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestReport = reports[0];

// 实时信源
const liveFeedsPath = path.join(process.cwd(), 'src/data/live_feeds.json');
const liveFeeds = JSON.parse(fs.readFileSync(liveFeedsPath, 'utf-8'));

// ===== 今日数据拆分 =====
const substantive = today?.changed?.filter((c: any) => c.kind === 'substantive') || [];
const jitter = today?.changed?.filter((c: any) => c.kind === 'jitter') || [];
const highlights = today?.highlights || [];

// 源类型中文标签
const TYPE_LABEL: Record<string, string> = {
  model_list: '模型列表', pricing: '定价', changelog: '更新日志', blog: '博客',
  api_docs: 'API 文档', github: 'GitHub', model_marketplace: '模型广场', industry: '行业数据',
};
const HL_TYPE: Record<string, { label: string; cls: string }> = {
  release: { label: '发布', cls: 't-release' },
  pricing: { label: '调价', cls: 't-pricing' },
  sunset: { label: '下线', cls: 't-sunset' },
  other: { label: '动态', cls: 't-other' },
};
const typeLabel = (t: string) => TYPE_LABEL[t] || t;

// 模型 ID 实体高亮
function highlightEntities(line: string) {
  const re = /([A-Za-z][\w.\-]*\/[\w.\-]+|(?<![A-Za-z])[a-z][a-z0-9]*(?:-[a-z0-9.]+){1,8}(?![A-Za-z]))/g;
  const out: { text: string; hl?: boolean }[] = [];
  let last = 0;
  for (const m of line.matchAll(re)) {
    const idx = m.index ?? 0;
    if (m[0].length < 4 || /^\d/.test(m[0])) { continue; }
    if (idx > last) out.push({ text: line.slice(last, idx) });
    out.push({ text: m[0], hl: true });
    last = idx + m[0].length;
  }
  if (last < line.length) out.push({ text: line.slice(last) });
  return out.length ? out : [{ text: line }];
}

// 周日期格式化：2026-08-31 ~ 2026-09-06 -> 8.31 — 9.6
function fmtWeekRange(w: any) {
  const f = (d: string) => { const [, m, dd] = d.split('-'); return `${+m}.${+dd}`; };
  return `${f(w.start)} — ${f(w.end)}`;
}
---
<Layout title="MaaS Daily — 全球 MaaS 平台每日追踪" description="每日自动追踪全球 MaaS 平台：模型发布、定价变更、API 更新。AI 要点提炼 + 逐日信号明细，过期内容按周归档。">
  {/* ===== HERO ===== */}
  <header class="hero">
    <div class="hero-main">
      <div class="eyebrow">DAILY SIGNAL · {today?.date?.replace(/-/g, '.') || ''}</div>
      <h1>MaaS 每日动态</h1>
      <p class="dek">每天 08:30 自动抓取 16 个平台 + 行业信源，AI 提炼当日要点，过滤页面抖动噪声。过期内容按周归档，周报深度分析保留。</p>
    </div>
    <aside class="hero-aside">
      <div class="pulse">
        <div class="pulse-item"><strong>{String(substantive.length).padStart(2, '0')}</strong><span>今日实质变化</span></div>
        <div class="pulse-item"><strong>{String(highlights.length).padStart(2, '0')}</strong><span>AI 要点</span></div>
        <div class="pulse-item"><strong>{today?.stats?.total ?? '—'}</strong><span>监控信源</span></div>
        <div class="pulse-item"><strong>{today?.stats?.success ?? '—'}</strong><span>抓取成功</span></div>
      </div>
    </aside>
  </header>

  {/* ===== LIVE 滚动条 ===== */}
  {liveFeeds.length > 0 && (
    <div class="ticker">
      <div class="ticker-label"><span class="live-pulse"></span> LIVE</div>
      <div class="ticker-track">
        <div class="ticker-content">
          {liveFeeds.map((f) => (
            <a href={f.url} target="_blank" rel="noopener" class="ticker-item">
              <span class="ticker-platform">{f.platform}</span>
              <span class="ticker-title">{f.title}</span>
              <span class="ticker-date">{f.date}</span>
            </a>
          ))}
          {liveFeeds.map((f) => (
            <a href={f.url} target="_blank" rel="noopener" class="ticker-item" aria-hidden="true">
              <span class="ticker-platform">{f.platform}</span>
              <span class="ticker-title">{f.title}</span>
              <span class="ticker-date">{f.date}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  )}

  <main class="daily-main">
    {/* ===== 01 今日要点 ===== */}
    <section class="section" id="digest">
      <div class="section-heading reveal">
        <div class="section-no">01 / DIGEST</div>
        <h2>今日要点</h2>
        <p class="section-note">AI 从当日增量中提炼{today?.date ? `（${today.date}）` : ''}。</p>
      </div>
      {highlights.length > 0 ? (
        <ul class="hl-list">
          {highlights.map((h: any) => (
            <li class={`hl-item reveal ${HL_TYPE[h.type]?.cls || 't-other'}`}>
              <span class="hl-type">{HL_TYPE[h.type]?.label || '动态'}</span>
              <span class="hl-platform">{h.platform}</span>
              <span class="hl-text">{h.text}</span>
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty-day">今日暂无 AI 要点（LLM 未运行或当日无实质变化），信号明细见下方。</div>
      )}
    </section>

    {/* ===== 02 今日信号明细 ===== */}
    <section class="section" id="signals">
      <div class="section-heading reveal">
        <div class="section-no">02 / SIGNALS</div>
        <h2>今日信号明细</h2>
        <p class="section-note">{substantive.length} 个信源有实质变化{jitter.length ? `，${jitter.length} 个仅常规波动（已折叠）` : ''}。点击卡片展开逐行 diff。</p>
      </div>
      <div class="change-list">
        {substantive.map((c: any) => (
          <details class="change-card reveal">
            <summary style="list-style:none;cursor:pointer">
              <div class="card-meta">
                <span class="platform">{c.platform}</span>
                <span class="source-type">{typeLabel(c.source_type)}</span>
                {c.pairs?.length > 0 && <span class="delta">~{c.pairs.length} 处变更</span>}
                {(c.added_count ?? 0) + (c.removed_count ?? 0) > 0 && (
                  <span class="delta">+{c.added_count ?? 0} / -{c.removed_count ?? 0}</span>
                )}
                <a class="src-link" href={c.url} target="_blank" rel="noopener" onclick="event.stopPropagation()">来源 ↗</a>
              </div>
              {c.signal_preview && (
                <div class="added-preview">
                  {highlightEntities(c.signal_preview).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}
                </div>
              )}
            </summary>
            <div class="diff-body">
              {c.pairs?.length > 0 && (
                <div class="diff-sec">
                  <div class="diff-label paired">变更 {c.pairs.length} 处（旧 → 新）</div>
                  <ul class="line-list">
                    {c.pairs.slice(0, 20).map((p: any) => (
                      <li class="line paired">
                        <span class="pair-old">{p.before.slice(0, 160)}</span>
                        <span class="pair-arrow">→</span>
                        <span class="pair-new">{p.after.slice(0, 160)}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {c.added_lines?.length > 0 && (
                <div class="diff-sec">
                  <div class="diff-label added">新增 {c.added_lines.length} 行</div>
                  <ul class="line-list">
                    {c.added_lines.slice(0, 15).map((l: string) => (
                      <li class="line added">
                        {highlightEntities(l.slice(0, 220)).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {c.removed_lines?.length > 0 && (
                <div class="diff-sec">
                  <div class="diff-label removed">删除 {c.removed_lines.length} 行</div>
                  <ul class="line-list">
                    {c.removed_lines.slice(0, 8).map((l: string) => <li class="line removed">{l.slice(0, 220)}</li>)}
                  </ul>
                </div>
              )}
            </div>
          </details>
        ))}
      </div>

      {jitter.length > 0 && (
        <details class="jitter-block">
          <summary style="list-style:none;cursor:pointer">
            <span class="jitter-label">◌ {jitter.length} 个信源仅有常规波动</span>
            <span class="jitter-names">{jitter.map((c: any) => c.platform).join(' · ')}</span>
          </summary>
          <ul class="jitter-list">
            {jitter.map((c: any) => (
              <li><span class="platform">{c.platform}</span> · {typeLabel(c.source_type)} — 数据抖动 {(c.raw_added_count ?? 0) + (c.raw_removed_count ?? 0)} 行，已过滤</li>
            ))}
          </ul>
        </details>
      )}

      {today?.failed?.length > 0 && (
        <details class="fail-block">
          <summary style="list-style:none;cursor:pointer"><span class="fail-label">⚠ {today.failed.length} 个信源抓取失败</span></summary>
          <ul>
            {today.failed.map((f: any) => (
              <li><span class="platform">{f.platform}</span> · {typeLabel(f.source_type)} — {f.error?.slice(0, 140)}</li>
            ))}
          </ul>
        </details>
      )}
    </section>

    {/* ===== 03 本周回顾 ===== */}
    {currentWeek && (
      <section class="section" id="week">
        <div class="section-heading reveal">
          <div class="section-no">03 / WEEK</div>
          <h2>本周回顾</h2>
          <p class="section-note">{currentWeek.week}（{fmtWeekRange(currentWeek)}）{currentWeek.story ? ' · AI 串讲' : ''}</p>
        </div>
        {currentWeek.story ? (
          <div class="week-story reveal">
            <div class="story-theme">{currentWeek.story.theme}</div>
            {currentWeek.story.story.split('\n').filter((p: string) => p.trim()).map((p: string) => <p>{p}</p>)}
          </div>
        ) : (
          <div class="empty-day">本周串讲将在周末生成（需一周数据收齐）。当前统计：{currentWeek.totals?.substantive ?? 0} 个实质变化，{currentWeek.totals?.releases ?? 0} 次发布，{currentWeek.totals?.pricings ?? 0} 次调价。</div>
        )}
        <div class="week-totals reveal">
          <span class="wt-item"><strong>{currentWeek.totals?.substantive ?? 0}</strong> 实质变化</span>
          <span class="wt-item"><strong>{currentWeek.totals?.releases ?? 0}</strong> 发布</span>
          <span class="wt-item"><strong>{currentWeek.totals?.pricings ?? 0}</strong> 调价</span>
          <span class="wt-item"><strong>{currentWeek.totals?.sunsets ?? 0}</strong> 下线</span>
          <a class="wt-link" href={`/daily/${currentWeek.week}/`}>本周全部要点 →</a>
        </div>
      </section>
    )}

    {/* ===== 04 周度归档 ===== */}
    {pastWeeks.length > 0 && (
      <section class="section" id="archive">
        <div class="section-heading reveal">
          <div class="section-no">04 / ARCHIVE</div>
          <h2>周度归档</h2>
          <p class="section-note">过期每日动态按 ISO 周聚合。</p>
        </div>
        <div class="archive-grid">
          {pastWeeks.map((w) => (
            <a href={`/daily/${w.week}/`} class="archive-card reveal">
              <div class="archive-week">{w.week}</div>
              <div class="archive-range">{fmtWeekRange(w)}</div>
              <div class="archive-stats">{w.totals?.substantive ?? 0} 变化 · {w.totals?.releases ?? 0} 发布</div>
              <div class="archive-arrow">→</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ===== 05 周报入口 ===== */}
    <section class="section" id="weekly">
      <div class="section-heading reveal">
        <div class="section-no">05 / WEEKLY</div>
        <h2>深度周报</h2>
        <p class="section-note">共 {reports.length} 期完整周报，深度分析与趋势洞察。</p>
      </div>
      <div class="weekly-cta reveal">
        <a href={`/weekly/${latestReport?.id}/`} class="weekly-latest">
          <span class="wl-tag">LATEST ISSUE</span>
          <span class="wl-date">{latestReport?.data?.date}</span>
          <span class="wl-title">{latestReport?.data?.title || 'MaaS 平台周度追踪报告'}</span>
          <span class="wl-arrow">阅读全文 →</span>
        </a>
        <div class="weekly-backlist">
          {reports.slice(1, 10).map((r) => (
            <a href={`/weekly/${r.id}/`} class="back-item">{r.data.date}</a>
          ))}
          {reports.length > 10 && <span class="back-more">…共 {reports.length} 期</span>}
        </div>
      </div>
    </section>
  </main>

  <p class="footnote">数据由 fetch_sources.py 每日自动抓取生成 · 经 diff_clean 降噪与 LLM 要点提炼 · 完整历史见仓库 data/ 目录</p>
</Layout>

<style>
  .hero {
    padding: 44px 0 30px;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, .6fr);
    gap: 50px;
    align-items: end;
  }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--acid); font: 700 12px/1.2 "SF Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
  .hero h1 { margin: 16px 0 14px; font-size: clamp(40px, 6vw, 68px); line-height: 1; letter-spacing: -.06em; }
  .dek { max-width: 620px; margin: 0; color: var(--paper-soft); font-size: 15px; line-height: 1.8; }
  .pulse { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .pulse-item { padding: 16px 14px; background: color-mix(in srgb, var(--ink) 92%, transparent); }
  .pulse strong { display: block; color: var(--acid); font: 700 22px/1 "SF Mono", monospace; }
  .pulse span { display: block; margin-top: 6px; color: var(--muted); font-size: 11px; }

  /* LIVE ticker */
  .ticker { display: flex; align-items: center; gap: 12px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); overflow: hidden; }
  .ticker-label { display: flex; align-items: center; gap: 6px; font: 700 11px/1 "SF Mono", monospace; letter-spacing: .12em; color: var(--red); padding: 10px 14px 10px 0; border-right: 1px solid var(--line); flex-shrink: 0; z-index: 2; background: var(--ink); position: relative; }
  .live-pulse { width: 7px; height: 7px; border-radius: 50%; background: var(--red); box-shadow: 0 0 0 3px var(--red-dim); animation: pulse 2s ease-in-out infinite; }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }
  .ticker-track { flex: 1; overflow: hidden; position: relative; mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%); -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%); }
  .ticker-content { display: flex; gap: 32px; animation: ticker-scroll 60s linear infinite; white-space: nowrap; padding: 10px 0; }
  .ticker-content:hover { animation-play-state: paused; }
  @keyframes ticker-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  .ticker-item { display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--paper); font-size: 12.5px; flex-shrink: 0; transition: color .15s; }
  .ticker-item:hover { color: var(--acid); }
  .ticker-platform { font: 700 11px/1 "SF Mono", monospace; color: var(--acid); letter-spacing: .04em; }
  .ticker-title { color: var(--paper-soft); }
  .ticker-date { font: 500 10px/1 "SF Mono", monospace; color: var(--muted); padding-left: 8px; border-left: 1px solid var(--line); }

  .daily-main { margin-top: 48px; }

  /* 01 要点 */
  .hl-list { list-style: none; display: grid; gap: 10px; margin: 0; padding: 0; }
  .hl-item { display: flex; align-items: baseline; gap: 10px; padding: 14px 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel); font-size: 14.5px; line-height: 1.7; flex-wrap: wrap; }
  .hl-type { flex: none; font: 700 10px/1 "SF Mono", monospace; letter-spacing: .08em; padding: 4px 8px; border-radius: 5px; margin-top: 3px; }
  .t-release .hl-type { color: var(--acid); background: var(--acid-dim); }
  .t-pricing .hl-type { color: var(--amber); background: var(--amber-dim); }
  .t-sunset .hl-type { color: var(--red); background: var(--red-dim); }
  .t-other .hl-type { color: var(--cyan); background: color-mix(in srgb, var(--cyan) 12%, transparent); }
  .hl-platform { flex: none; font-family: "Songti SC", serif; font-weight: 700; color: var(--paper-soft); }
  .hl-text { color: var(--paper-soft); min-width: 200px; flex: 1; }

  /* 02 信号明细 */
  .change-list { display: grid; gap: 12px; }
  .change-card { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); overflow: hidden; transition: border-color .2s ease; }
  .change-card:hover { border-color: var(--line-strong); }
  .change-card[open] { border-color: var(--amber); }
  .change-card summary::-webkit-details-marker { display: none; }
  .card-meta { display: flex; align-items: center; gap: 16px; padding: 16px 22px; flex-wrap: wrap; }
  .platform { font-family: "Songti SC", serif; font-weight: 700; font-size: 16px; }
  .source-type { color: var(--cyan); font: 700 11px/1 "SF Mono", monospace; letter-spacing: .06em; padding: 5px 9px; background: color-mix(in srgb, var(--cyan) 12%, transparent); border-radius: 6px; }
  .delta { color: var(--amber); font: 700 12px/1 "SF Mono", monospace; }
  .src-link { margin-left: auto; color: var(--muted); font: 500 11px/1 "SF Mono", monospace; text-decoration: none; border-bottom: 1px dotted var(--muted); }
  .src-link:hover { color: var(--acid); border-color: var(--acid); }
  .added-preview { padding: 0 22px 16px; color: var(--paper-soft); font-size: 13.5px; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .diff-body { padding: 6px 22px 20px; border-top: 1px solid var(--line); }
  .diff-sec { margin-top: 14px; }
  .diff-label { font: 700 10px/1 "SF Mono", monospace; letter-spacing: .1em; margin-bottom: 10px; }
  .diff-label.added { color: var(--acid); }
  .diff-label.removed { color: var(--red); }
  .diff-label.paired { color: var(--cyan); }
  .line-list { list-style: none; display: grid; gap: 6px; }
  .line { font: 400 12px/1.6 "SF Mono", monospace; padding: 8px 12px; border-radius: 6px; word-break: break-all; }
  .line.added { color: var(--paper-soft); background: var(--acid-dim); border-left: 2px solid var(--acid); }
  .line.removed { color: var(--muted); background: var(--red-dim); border-left: 2px solid var(--red); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--red) 55%, transparent); }
  .line.paired { display: flex; align-items: baseline; gap: 10px; color: var(--paper-soft); background: color-mix(in srgb, var(--cyan) 7%, transparent); border-left: 2px solid var(--cyan); flex-wrap: wrap; }
  .pair-old { color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--red) 45%, transparent); }
  .pair-arrow { color: var(--cyan); flex: none; }
  .pair-new { color: var(--paper-soft); }
  .ent { font: 700 12px/1.6 "SF Mono", monospace; color: var(--acid); background: var(--acid-dim); padding: 1px 5px; border-radius: 4px; }
  .jitter-block { margin-top: 12px; border: 1px dashed var(--line); border-radius: 12px; background: transparent; }
  .jitter-block summary::-webkit-details-marker { display: none; }
  .jitter-block summary { display: flex; align-items: baseline; gap: 12px; padding: 12px 18px; flex-wrap: wrap; }
  .jitter-label { color: var(--muted); font: 700 12px/1 "SF Mono", monospace; }
  .jitter-names { color: var(--muted); font-size: 12px; opacity: .75; }
  .jitter-list { list-style: none; padding: 0 18px 14px; display: grid; gap: 6px; }
  .jitter-list li { color: var(--muted); font-size: 12.5px; }
  .jitter-list .platform { color: var(--paper-soft); font-size: 13px; }
  .fail-block { margin-top: 12px; border: 1px solid color-mix(in srgb, var(--red) 35%, transparent); border-radius: 12px; background: var(--red-dim); }
  .fail-block summary::-webkit-details-marker { display: none; }
  .fail-label { display: block; padding: 13px 20px; color: var(--red); font: 700 12px/1 "SF Mono", monospace; }
  .fail-block ul { list-style: none; padding: 0 20px 16px; display: grid; gap: 6px; }
  .fail-block li { color: var(--muted); font-size: 12.5px; }
  .fail-block .platform { color: var(--paper-soft); }

  /* 03 本周回顾 */
  .week-story { border: 1px solid color-mix(in srgb, var(--acid) 30%, transparent); border-radius: 14px; background: linear-gradient(135deg, var(--acid-dim), transparent 65%); padding: 26px 30px; }
  .story-theme { font: 700 20px/1.3 "Songti SC", serif; color: var(--paper); margin-bottom: 16px; }
