---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { logoFor } from '../lib/platforms';
import fs from 'node:fs';
import path from 'node:path';

// ===== 数据源 =====
const dataPath = path.join(process.cwd(), 'src/data/daily_changes.json');
const data = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const days: any[] = data.days || [];
const today = days[0];

const weeklyPath = path.join(process.cwd(), 'src/data/weekly-digest.json');
let weeks: any[] = [];
try { weeks = JSON.parse(fs.readFileSync(weeklyPath, 'utf-8')); } catch {}
const currentWeek = weeks[0];
const pastWeeks = weeks.slice(1);

const reports = await getCollection('weekly', ({ data }) => data.date <= new Date().toISOString().slice(0, 10));
reports.sort((a, b) => b.data.date.localeCompare(a.data.date));
const latestReport = reports[0];

// ===== 今日数据拆分 =====
const substantive = today?.changed?.filter((c: any) => c.kind === 'substantive') || [];
const highlights = today?.highlights || []; // v3: [{platform, logo_summary, items:[{text,type}]}]

// 要点按平台分组（已经是 v3 结构）
// 有要点或实质变化的平台集合（信号明细按平台分组展示）
const platformsInSignals: Record<string, any[]> = {};
for (const c of substantive) {
  (platformsInSignals[c.platform] ||= []).push(c);
}
// 平台排序：有 highlights 的平台在前，其余按实质变化数
const platformOrder = [...new Set([...highlights.map((h: any) => h.platform), ...Object.keys(platformsInSignals)])];

const TYPE_LABEL: Record<string, string> = {
  model_list: '模型列表', pricing: '定价', changelog: '更新日志', blog: '博客',
  api_docs: 'API 文档', github: 'GitHub', model_marketplace: '模型广场', industry: '行业数据',
};
const HL_TYPE: Record<string, { label: string; cls: string }> = {
  release: { label: '发布', cls: 't-release' },
  pricing: { label: '调价', cls: 't-pricing' },
  sunset: { label: '下线', cls: 't-sunset' },
  other: { label: '动态', cls: 't-other' },
};
const typeLabel = (t: string) => TYPE_LABEL[t] || t;

// 日期格式化：2026-09-04 -> 2026.09.04 / 9.4
const dateLong = today?.date?.replace(/-/g, '.') || '';
const dateShort = today?.date ? (() => { const [, m, d] = today.date.split('-'); return `${+m}.${+d}`; })() : '';
const weekday = today?.date ? '周' + '一二三四五六日'[new Date(today.date).getDay()] : '';

// 模型 ID / 关键实体高亮（返回段数组，模板内渲染为 code.ent）
function highlightEntities(line: string) {
  const re = /([A-Za-z][\w.\-]*\/[\w.\-]+|(?<![A-Za-z])[a-z][a-z0-9]*(?:-[a-z0-9.]+){1,8}(?![A-Za-z])|[A-Z][a-zA-Z]*\s?\d+(?:\.\d+)*(?:\s?(?:Flash|Pro|Max|Astra|Terra|Luna))?)/g;
  const out: { text: string; hl?: boolean }[] = [];
  let last = 0;
  for (const m of line.matchAll(re)) {
    const idx = m.index ?? 0;
    if (m[0].length < 4 || /^\d/.test(m[0])) { continue; }
    if (idx > last) out.push({ text: line.slice(last, idx) });
    out.push({ text: m[0], hl: true });
    last = idx + m[0].length;
  }
  if (last < line.length) out.push({ text: line.slice(last) });
  return out.length ? out : [{ text: line }];
}

const fmtWeekRange = (w: any) => {
  const f = (d: string) => { const [, m, dd] = d.split('-'); return `${+m}.${+dd}`; };
  return `${f(w.start)} — ${f(w.end)}`;
};

// 周故事段落
const storyParas = (currentWeek?.story?.story || '').split('\n').filter((p: string) => p.trim());
// 周要点按平台统计（v3 展平后已存 weekly-digest 的 highlights）
const weekHighlightCount = currentWeek?.highlights?.length || 0;
---
<Layout title="MaaS Daily — 全球 MaaS 平台每日追踪" description="每日自动追踪全球 MaaS 平台：模型发布、定价变更、API 更新。AI 要点提炼 + 逐日信号明细，过期内容按周归档。">
  {/* ===== HERO：日期为主体 ===== */}
  <header class="hero">
    <div class="hero-main">
      <div class="eyebrow">MAAS DAILY SIGNAL</div>
      <h1 class="date-hero">
        <span class="brand-main">MaaS<br/>每日动态</span>
        <span class="date-block">
          <span class="date-num">{dateShort}</span>
          <span class="date-meta">
            <span class="date-year">{dateLong}</span>
            <span class="date-week">{weekday} · 今日</span>
          </span>
        </span>
      </h1>
      <p class="dek">每天 08:30 自动抓取 16 个平台 + 行业信源，AI 提炼当日要点。过期内容按周归档，深度周报保留。</p>
    </div>
    <aside class="hero-aside">
      <div class="pulse">
        <div class="pulse-item"><strong>{String(substantive.length).padStart(2, '0')}</strong><span>实质变化</span></div>
        <div class="pulse-item"><strong>{String(highlights.reduce((s: number, h: any) => s + h.items.length, 0)).padStart(2, '0')}</strong><span>AI 要点</span></div>
        <div class="pulse-item"><strong>{today?.stats?.total ?? '—'}</strong><span>监控信源</span></div>
        <div class="pulse-item"><strong>{today?.stats?.success ?? '—'}</strong><span>抓取成功</span></div>
      </div>
    </aside>
  </header>

  <main class="daily-main">
    {/* ===== 01 今日要点（按平台分组 + logo） ===== */}
    <section class="section" id="digest">
      <div class="section-heading reveal">
        <div class="section-no">01 / DIGEST</div>
        <h2>今日要点</h2>
        <p class="section-note">AI 按平台提炼当日动态，关键实体高亮。</p>
      </div>
      {highlights.length > 0 ? (
        <div class="platform-grid">
          {highlights.map((h: any) => (
            <article class="platform-card reveal">
              <header class="pc-head">
                {logoFor(h.platform) ? <img class="pc-logo" src={logoFor(h.platform)} alt={h.platform} loading="lazy" /> : <span class="pc-logo pc-logo-fallback">{h.platform.slice(0, 1)}</span>}
                <div class="pc-title">
                  <h3>{h.platform}</h3>
                  <p class="pc-summary">{h.logo_summary}</p>
                </div>
              </header>
              <ul class="pc-items">
                {h.items.map((item: any) => (
                  <li class={`pc-item ${HL_TYPE[item.type]?.cls || 't-other'}`}>
                    <span class="hl-type">{HL_TYPE[item.type]?.label || '动态'}</span>
                    <span class="pc-text">{highlightEntities(item.text).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty-day">今日暂无 AI 要点（LLM 未运行或当日无实质变化），信号明细见下方。</div>
      )}
    </section>

    {/* ===== 02 今日信号明细（按平台分组 + logo + LLM 解读） ===== */}
    <section class="section" id="signals">
      <div class="section-heading reveal">
        <div class="section-no">02 / SIGNALS</div>
        <h2>今日信号明细</h2>
        <p class="section-note">{platformOrder.length} 个平台有实质变化，按平台分组。每条附 AI 变化解读，点击展开逐行 diff。</p>
      </div>
      {platformOrder.map((platform) => {
        const sources = platformsInSignals[platform] || [];
        const hl = highlights.find((h: any) => h.platform === platform);
        return (
          <div class="signal-platform reveal">
            <header class="sp-head">
              {logoFor(platform) ? <img class="pc-logo" src={logoFor(platform)} alt={platform} loading="lazy" /> : <span class="pc-logo pc-logo-fallback">{platform.slice(0, 1)}</span>}
              <h3>{platform}</h3>
              {hl?.logo_summary && <span class="sp-summary">{hl.logo_summary}</span>}
              <span class="sp-count">{sources.length} 个信源</span>
            </header>
            <div class="sp-sources">
              {sources.map((c: any) => (
                <details class="change-card">
                  <summary style="list-style:none;cursor:pointer">
                    <div class="card-meta">
                      <span class="source-type">{typeLabel(c.source_type)}</span>
                      {c.pairs?.length > 0 && <span class="delta">~{c.pairs.length} 处变更</span>}
                      {(c.added_count ?? 0) + (c.removed_count ?? 0) > 0 && (
                        <span class="delta">+{c.added_count ?? 0} / -{c.removed_count ?? 0}</span>
                      )}
                      <a class="src-link" href={c.url} target="_blank" rel="noopener" onclick="event.stopPropagation()">来源 ↗</a>
                    </div>
                    {c.llm_summary ? (
                      <p class="llm-summary">{c.llm_summary}</p>
                    ) : c.signal_preview ? (
                      <p class="added-preview">{highlightEntities(c.signal_preview).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}</p>
                    ) : null}
                  </summary>
                  <div class="diff-body">
                    {c.pairs?.length > 0 && (
                      <div class="diff-sec">
                        <div class="diff-label paired">变更 {c.pairs.length} 处（旧 → 新）</div>
                        <ul class="line-list">
                          {c.pairs.slice(0, 20).map((p: any) => (
                            <li class="line paired">
                              <span class="pair-old">{p.before.slice(0, 160)}</span>
                              <span class="pair-arrow">→</span>
                              <span class="pair-new">{p.after.slice(0, 160)}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {c.added_lines?.length > 0 && (
                      <div class="diff-sec">
                        <div class="diff-label added">新增 {c.added_lines.length} 行</div>
                        <ul class="line-list">
                          {c.added_lines.slice(0, 15).map((l: string) => (
                            <li class="line added">{highlightEntities(l.slice(0, 220)).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                    {c.removed_lines?.length > 0 && (
                      <div class="diff-sec">
                        <div class="diff-label removed">删除 {c.removed_lines.length} 行</div>
                        <ul class="line-list">
                          {c.removed_lines.slice(0, 8).map((l: string) => <li class="line removed">{l.slice(0, 220)}</li>)}
                        </ul>
                      </div>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </div>
        );
      })}
    </section>

    {/* ===== 03 本周回顾（结构化） ===== */}
    {currentWeek && (
      <section class="section" id="week">
        <div class="section-heading reveal">
          <div class="section-no">03 / WEEK</div>
          <h2>本周回顾</h2>
          <p class="section-note">{currentWeek.week}（{fmtWeekRange(currentWeek)}）</p>
        </div>
        <div class="week-panel reveal">
          <div class="week-side">
            <div class="week-theme-card">
              <div class="wt-kicker">WEEK THEME</div>
              <div class="wt-theme">{currentWeek.story?.theme || '数据积累中'}</div>
            </div>
            <div class="week-metrics">
              <div class="wm-item"><strong>{currentWeek.totals?.substantive ?? 0}</strong><span>实质变化</span></div>
              <div class="wm-item c-release"><strong>{currentWeek.totals?.releases ?? 0}</strong><span>发布</span></div>
              <div class="wm-item c-pricing"><strong>{currentWeek.totals?.pricings ?? 0}</strong><span>调价</span></div>
              <div class="wm-item c-sunset"><strong>{currentWeek.totals?.sunsets ?? 0}</strong><span>下线</span></div>
            </div>
            <a class="wt-link" href={`/daily/${currentWeek.week}/`}>本周逐日要点 →</a>
          </div>
          <div class="week-body">
            {storyParas.length > 0 ? storyParas.map((p: string) => <p>{highlightEntities(p).map((seg: any) => seg.hl ? <code class="ent">{seg.text}</code> : seg.text)}</p>) : (
              <p class="week-pending">本周串讲将在周末数据收齐后生成。当前已积累 {weekHighlightCount} 条要点。</p>
            )}
          </div>
        </div>
      </section>
    )}

    {/* ===== 04 周度归档 ===== */}
    {pastWeeks.length > 0 && (
      <section class="section" id="archive">
        <div class="section-heading reveal">
          <div class="section-no">04 / ARCHIVE</div>
          <h2>周度归档</h2>
          <p class="section-note">过期每日动态按 ISO 周聚合。</p>
        </div>
        <div class="archive-grid">
          {pastWeeks.map((w) => (
            <a href={`/daily/${w.week}/`} class="archive-card reveal">
              <div class="archive-week">{w.week}</div>
              <div class="archive-range">{fmtWeekRange(w)}</div>
              <div class="archive-stats">{w.totals?.substantive ?? 0} 变化 · {w.totals?.releases ?? 0} 发布</div>
              <div class="archive-arrow">→</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* ===== 05 周报入口 ===== */}
    <section class="section" id="weekly">
      <div class="section-heading reveal">
        <div class="section-no">05 / WEEKLY</div>
        <h2>深度周报</h2>
        <p class="section-note">共 {reports.length} 期完整周报，深度分析与趋势洞察。</p>
      </div>
      <div class="weekly-cta reveal">
        <a href={`/weekly/${latestReport?.id}/`} class="weekly-latest">
          <span class="wl-tag">LATEST ISSUE</span>
          <span class="wl-date">{latestReport?.data?.date}</span>
          <span class="wl-title">{latestReport?.data?.title || 'MaaS 平台周度追踪报告'}</span>
          <span class="wl-arrow">阅读全文 →</span>
        </a>
        <div class="weekly-backlist">
          {reports.slice(1, 10).map((r) => (
            <a href={`/weekly/${r.id}/`} class="back-item">{r.data.date}</a>
          ))}
          {reports.length > 10 && <span class="back-more">…共 {reports.length} 期</span>}
        </div>
      </div>
    </section>
  </main>

  <p class="footnote">数据由 fetch_sources.py 每日自动抓取 · 经 diff_clean 降噪与 LLM 要点提炼 · 完整历史见仓库 data/ 目录</p>
</Layout>

<style>
  /* ===== HERO：MaaS 主体 + 日期强调 ===== */
  .hero {
    padding: 40px 0 30px;
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, .6fr);
    gap: 50px;
    align-items: end;
  }
  .eyebrow { display: flex; align-items: center; gap: 12px; color: var(--acid); font: 700 12px/1.2 "SF Mono", monospace; letter-spacing: .14em; text-transform: uppercase; }
  .eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
  .date-hero { display: flex; align-items: flex-end; gap: 26px; margin: 10px 0 16px; }
  .brand-main { font-family: "Songti SC", serif; font-size: clamp(44px, 6.5vw, 72px); font-weight: 800; line-height: 1.02; letter-spacing: -.04em; color: var(--paper); }
  .date-block { display: flex; align-items: baseline; gap: 12px; padding-bottom: 6px; }
  .date-num { font: 700 clamp(40px, 5vw, 58px)/1 "SF Mono", monospace; letter-spacing: -.04em; color: var(--acid); }
  .date-meta { display: grid; gap: 5px; }
  .date-year { font: 700 14px/1 "SF Mono", monospace; color: var(--muted); letter-spacing: .04em; }
  .date-week { font: 600 14px/1.3 "Songti SC", serif; color: var(--paper-soft); }
  .dek { max-width: 620px; margin: 0; color: var(--paper-soft); font-size: 14.5px; line-height: 1.8; }
  .pulse { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .pulse-item { padding: 16px 14px; background: color-mix(in srgb, var(--ink) 92%, transparent); }
  .pulse strong { display: block; color: var(--acid); font: 700 22px/1 "SF Mono", monospace; }
  .pulse span { display: block; margin-top: 6px; color: var(--muted); font-size: 11px; }

  .daily-main { margin-top: 44px; }

  /* ===== 01 平台卡片 ===== */
  .platform-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(380px, 1fr)); gap: 14px; }
  .platform-card { border: 1px solid var(--line); border-radius: 16px; background: var(--panel); padding: 22px 24px; transition: border-color .2s ease, transform .2s ease; }
  .platform-card:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .pc-head { display: flex; align-items: center; gap: 14px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .pc-logo { width: 36px; height: 36px; border-radius: 9px; background: var(--ink); border: 1px solid var(--line); padding: 5px; object-fit: contain; flex: none; }
  .pc-logo-fallback { display: grid; place-items: center; font: 700 16px/1 "Songti SC", serif; color: var(--acid); }
  .pc-title h3 { margin: 0; font-family: "Songti SC", serif; font-size: 17px; font-weight: 700; }
  .pc-summary { margin: 3px 0 0; color: var(--muted); font-size: 12.5px; line-height: 1.5; }
  .pc-items { list-style: none; display: grid; gap: 10px; margin: 14px 0 0; padding: 0; }
  .pc-item { display: flex; align-items: baseline; gap: 10px; font-size: 13.8px; line-height: 1.7; }
  .hl-type { flex: none; font: 700 10px/1 "SF Mono", monospace; letter-spacing: .08em; padding: 4px 8px; border-radius: 5px; margin-top: 3px; }
  .t-release .hl-type { color: var(--acid); background: var(--acid-dim); }
  .t-pricing .hl-type { color: var(--amber); background: var(--amber-dim); }
  .t-sunset .hl-type { color: var(--red); background: var(--red-dim); }
  .t-other .hl-type { color: var(--cyan); background: color-mix(in srgb, var(--cyan) 12%, transparent); }
  .pc-text { color: var(--paper-soft); }
  .ent { font: 700 .92em/1.6 "SF Mono", monospace; color: var(--acid); background: var(--acid-dim); padding: 1px 5px; border-radius: 4px; }

  /* ===== 02 信号明细（按平台分组） ===== */
  .signal-platform { margin-bottom: 26px; }
  .sp-head { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  .sp-head h3 { margin: 0; font-family: "Songti SC", serif; font-size: 18px; font-weight: 700; }
  .sp-summary { color: var(--muted); font-size: 12.5px; }
  .sp-count { margin-left: auto; color: var(--muted); font: 600 11px/1 "SF Mono", monospace; }
  .sp-sources { display: grid; gap: 10px; margin-left: 48px; }
  .change-card { border: 1px solid var(--line); border-radius: 14px; background: var(--panel); overflow: hidden; transition: border-color .2s ease; }
  .change-card:hover { border-color: var(--line-strong); }
  .change-card[open] { border-color: var(--amber); }
  .change-card summary::-webkit-details-marker { display: none; }
  .card-meta { display: flex; align-items: center; gap: 14px; padding: 13px 20px; flex-wrap: wrap; }
  .source-type { color: var(--cyan); font: 700 11px/1 "SF Mono", monospace; letter-spacing: .06em; padding: 5px 9px; background: color-mix(in srgb, var(--cyan) 12%, transparent); border-radius: 6px; }
  .delta { color: var(--amber); font: 700 12px/1 "SF Mono", monospace; }
  .src-link { margin-left: auto; color: var(--muted); font: 500 11px/1 "SF Mono", monospace; text-decoration: none; border-bottom: 1px dotted var(--muted); }
  .src-link:hover { color: var(--acid); border-color: var(--acid); }
  .llm-summary { margin: 0; padding: 0 20px 14px; color: var(--paper-soft); font-size: 13.2px; line-height: 1.75; }
  .added-preview { margin: 0; padding: 0 20px 14px; color: var(--muted); font-size: 12.5px; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .diff-body { padding: 6px 20px 18px; border-top: 1px solid var(--line); }
  .diff-sec { margin-top: 12px; }
  .diff-label { font: 700 10px/1 "SF Mono", monospace; letter-spacing: .1em; margin-bottom: 8px; }
  .diff-label.added { color: var(--acid); }
  .diff-label.removed { color: var(--red); }
  .diff-label.paired { color: var(--cyan); }
  .line-list { list-style: none; display: grid; gap: 6px; }
  .line { font: 400 12px/1.6 "SF Mono", monospace; padding: 8px 12px; border-radius: 6px; word-break: break-all; }
  .line.added { color: var(--paper-soft); background: var(--acid-dim); border-left: 2px solid var(--acid); }
  .line.removed { color: var(--muted); background: var(--red-dim); border-left: 2px solid var(--red); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--red) 55%, transparent); }
  .line.paired { display: flex; align-items: baseline; gap: 10px; color: var(--paper-soft); background: color-mix(in srgb, var(--cyan) 7%, transparent); border-left: 2px solid var(--cyan); flex-wrap: wrap; }
  .pair-old { color: var(--muted); text-decoration: line-through; text-decoration-color: color-mix(in srgb, var(--red) 45%, transparent); }
  .pair-arrow { color: var(--cyan); flex: none; }
  .pair-new { color: var(--paper-soft); }

  .empty-day { padding: 22px 26px; border: 1px dashed var(--line); border-radius: 14px; color: var(--muted); font-size: 13.5px; }

  /* ===== 03 本周回顾（结构化面板） ===== */
  .week-panel { display: grid; grid-template-columns: 320px 1fr; gap: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--panel); }
  .week-side { padding: 28px; border-right: 1px solid var(--line); background: linear-gradient(160deg, var(--acid-dim), transparent 70%); display: flex; flex-direction: column; gap: 22px; }
  .week-theme-card { display: grid; gap: 10px; }
  .wt-kicker { color: var(--acid); font: 700 10px/1 "SF Mono", monospace; letter-spacing: .14em; }
  .wt-theme { font-family: "Songti SC", serif; font-size: 22px; font-weight: 700; line-height: 1.35; color: var(--paper); }
  .week-metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
