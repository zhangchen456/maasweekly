---
import Layout from '../../layouts/Layout.astro';
import '../../styles/home-overview.css';
import { modelRelease } from '../../lib/model-pages';
import { homeModelGroups } from '../../lib/home-models';
const groups = homeModelGroups(); const release = modelRelease();
---
<Layout locale="en" title="Model API prices, billing conditions and evidence — MaaS Daily" description="Compare observed model API prices in their original currencies. Check billing conditions, data freshness, evidence and official pricing sources.">
  <section class="english-hero"><p>MODEL API PRICE TRACKING</p><h1>Understand the price behind each model API.</h1>
    <p>Check input, output and cache charges with their original currencies, units and conditions. Follow the evidence back to official pricing pages.</p>
    <p>Data through <time datetime={release.dataThrough}>{release.dataThrough}</time>. Both language versions use the same verified dataset.</p>
    <p><a href="/en/models/">Browse model prices →</a> · <a href="/en/pricing/">Search pricing records →</a></p>
  </section>
  <section class="market-section"><h2>Flagship and everyday models</h2><p>Grouped by official positioning, not benchmark rank. Selection reviewed {groups[0]?.reviewedAt}. Prices shown in their original currencies, per million tokens.</p>
    <div data-model-tabs>
      <div class="model-group-nav" role="tablist" aria-label="Model comparison groups">{groups.map((group,index) => <button type="button" role="tab" id={`model-tab-${group.id}`} aria-controls="home-model-panel" aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1} data-model-tab={group.id}>{group.titleEn}<span>{group.models.length}</span></button>)}</div>
      <div id="home-model-panel" role="tabpanel" aria-labelledby={`model-tab-${groups[0].id}`} tabindex="0">
        {groups.map((group,index) => <p data-model-description={group.id} hidden={index !== 0}>{group.descriptionEn}</p>)}
        <div class="market-table-wrap"><table class="market-table market-simple"><thead><tr><th scope="col">Model and positioning</th><th scope="col">Input</th><th scope="col">Output</th><th scope="col">Conditions</th></tr></thead>{groups.map((group,index) => <tbody data-home-group={group.id} hidden={index !== 0}>{group.models.map(page => <tr data-home-model={page.pick.modelId}>
          <td>{page.modelHref ? <a href={`/en${page.modelHref}`}>{page.pick.name}</a> : <strong>{page.pick.name}</strong>}<small>{page.pick.reasonEn}</small><a class="model-selection-source" href={page.pick.source} target="_blank" rel="noopener noreferrer">Official positioning ↗</a></td>
          <td>{page.input ? <><span class="quote-value">{Number(page.input.amount)}</span><small>{page.input.currency} / {page.input.unitQuantity} {page.input.unitName}s</small></> : 'Verified quote pending'}</td>
          <td>{page.output ? <><span class="quote-value">{Number(page.output.amount)}</span><small>{page.output.currency} / {page.output.unitQuantity} {page.output.unitName}s</small></> : '—'}</td>
          <td>{page.input && <details class="quote-details"><summary>View conditions</summary><p>{page.conditionEn}</p><p>Cache read: {page.cache ? `${Number(page.cache.amount)} ${page.cache.currency} per ${page.cache.unitQuantity} tokens` : 'Not listed'}</p><p>Observed {page.input.observedAt.slice(0,10)} · Complete evidence</p></details>}{page.modelHref && <a class="quote-link" href={`/en${page.modelHref}`}>Quotes and evidence ↗</a>}</td>
        </tr>)}</tbody>)}</table></div>
      </div>
      <noscript><style>[data-home-group][hidden]{display:table-row-group!important}[data-model-description][hidden]{display:block!important}.model-group-nav{display:none}</style><p>JavaScript is disabled; all groups are displayed in order.</p></noscript>
    </div>
  </section>
  <section><h2>Compare conditions before costs</h2><p>Regions, service tiers, billing modes, context bands and time conditions may differ. We keep each condition visible and do not infer a lowest price across incompatible offers.</p><p>English content does not imply overseas registration, payment or API access. These capabilities have not been verified.</p><p><a href="/en/method/">Read the data method</a> · <a href="/en/agent/">Use REST, MCP, RSS or the Agent Skill</a></p></section>
</Layout>
<style is:global>
  .english-hero {padding:48px 0 30px;max-width:860px}.english-hero h1{font-size:clamp(32px,5vw,56px);line-height:1.1}
  html[lang=en] main p{line-height:1.7;color:var(--muted)}html[lang=en] main a{color:var(--cyan)}
  html[lang=en] main section{margin-bottom:36px}.model-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
  .model-grid article{padding:20px;border:1px solid var(--line);border-radius:12px}html[lang=en] code{overflow-wrap:anywhere}
  .english-filters{display:flex;flex-wrap:wrap;gap:16px;margin:20px 0}.english-filters label{display:flex;flex-direction:column;gap:6px}
  .english-filters input,.english-filters select{padding:8px;background:var(--panel-solid);color:var(--paper);border:1px solid var(--line);border-radius:6px}
</style>

<script src="../../scripts/home-model-tabs.ts"></script>
