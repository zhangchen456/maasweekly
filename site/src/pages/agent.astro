---
import Layout from '../layouts/Layout.astro';
import CopyBlock from '../components/CopyBlock.astro';
import { PUBLIC_ACCESS as P, validatePublicAccessConfig } from '../config/public-access';
import { loadVerifiedRelease } from '../lib/release';
const violations = validatePublicAccessConfig(P);
if (violations.length) throw new Error(`[agent] ${violations.join('；')}`);
const release = loadVerifiedRelease(undefined, { select: ['changes'] });
const base = P.canonicalBaseUrl;
const methods = [
  { key: 'skill', name: 'Agent Skill', hint: '让 Agent 帮你安装', mark: '01' },
  { key: 'mcp', name: 'MCP', hint: '连接你的 AI 客户端', mark: '02' },
  { key: 'rss', name: 'RSS', hint: '在阅读器里订阅', mark: '03' },
  { key: 'rest', name: 'REST API', hint: '接入代码与工作流', mark: '04' },
] as const;
const statusLabel = (status: string) => status === 'available' ? '已上线' : status === 'pending' ? '待部署' : '不可用';
const verify = '用 maas-daily 查询最近 7 天 OpenAI 的变化，最多列出 5 条中文摘要和站内详情链接。注明数据截至日期与覆盖范围；不足 5 条或没有匹配记录时如实说明。';
const installPrompt = `请帮我安装 MaaS Daily Skill：${base}/maas-skill/README.md\n\n先阅读安装说明，确认当前客户端支持的 Skill 目录，将 maas-daily 安装到该目录下；--dir 必须指向最终的 maas-daily 目录。若已安装，请更新原目录，不创建重复副本。\n安装完成后告诉我安装位置、是否需要开启新会话，以及如何验证。\n\n新会话中的验证问题：\n${verify}`;
const updatePrompt = `请更新我已安装的 MaaS Daily Skill：${base}/maas-skill/README.md\n先确认当前正在使用的安装目录和是否有重复副本，再使用安装器更新同一目录。若发现未知文件或安装器拒绝覆盖，请说明原因，不强行覆盖。\n更新后告诉我是否需要开启新会话，并用以下问题验证：\n${verify}`;
const questions = [
  { title: '追踪平台变化', text: verify },
  { title: '核对模型价格', text: '用 maas-daily 查询 gpt-4o 当前记录的输入价格。逐项列出全部匹配候选的币种、单位、适用条件、观察时间、证据 ID 和链接，不合并不同条件的价格；没有匹配记录时如实说明。' },
  { title: '读最新周报', text: '用 maas-daily 获取最新一期正式周报，提炼主要变化并附周报链接、期号和数据截至日期。没有正式周报时如实说明，不用滚动 7 天摘要代替。' },
];
const mcpConfig = JSON.stringify({ mcpServers: { 'maas-daily': { type: 'http', url: `${base}${P.paths.mcpEndpoint}` } } }, null, 2);
---
<Layout title="Agent 接入 — MaaS Daily" description="复制一段提示词，让 Agent 接入 MaaS Daily。查询平台变化、模型价格与正式周报，无需 API Key。">
  <div class="agent-page">
    <header class="agent-hero">
      <div class="kicker">MAAS DAILY / FOR AGENTS</div>
      <h1>把 MaaS 动态，<br />接进你的 Agent。</h1>
      <p class="intro">平台有什么变化、模型价格是多少、这周值得关注什么。<br class="desktop-break" />让 Agent 带着来源回答你。</p>
      <div class="hero-meta"><span>匿名只读</span><span>无需 API Key</span><span>数据截至 {release.dataThrough}</span></div>
    </header>

    <div class="access-layout">
      <div class="access-main">
        <nav class="method-tabs" aria-label="选择接入方式">
          {methods.map(({key, name, hint, mark}) => <a href={`#method-${key}`} data-method={key}><span class="tab-top"><span>{name}</span><small>{mark}</small></span><span class="tab-hint">{hint}</span></a>)}
        </nav>

        <section class="method-panel" id="method-skill" data-panel="skill">
          <div class="panel-heading"><span class="eyebrow">从这里开始</span><span class={`status ${P.surfaces.skill.status}`}>{statusLabel(P.surfaces.skill.status)}</span></div>
          <h2>复制给 Agent，剩下的交给它</h2>
          <p class="description">适合支持 Skills 的 Agent。安装一次，以后直接用中文问。</p>
          <ol class="quick-steps"><li><b>01</b><span>复制下方提示词<small>发给你正在使用的 Agent</small></span></li><li><b>02</b><span>按提示开新会话<small>让客户端发现新安装的 Skill</small></span></li><li><b>03</b><span>问一句，确认接通<small>看到日期、摘要和来源链接</small></span></li></ol>
          <div class="prompt-card"><div class="prompt-heading"><span>安装提示词</span><small>完整复制，直接发送</small></div><CopyBlock code={installPrompt} label="安装提示词" /></div>
          <p class="after-copy">复制后粘贴到 Agent 对话框发送；本页不会自动安装。</p>
          <div class="subsection"><h3>装好后，试着这样问</h3><div class="question-list">{questions.map(q => <details><summary>{q.title}<span>查看提问 ↗</span></summary><CopyBlock code={q.text} label="问题" /></details>)}</div></div>
          <details class="advanced"><summary>已有 Skill？更新到最新版<span>＋</span></summary><CopyBlock code={updatePrompt} label="更新提示词" /></details>
          <details class="advanced"><summary>手动安装与排查<span>＋</span></summary><p>在当前客户端支持的 skills 目录下安装。以下是 Claude Code 的目录示例；其他客户端请替换路径，保留末尾的 maas-daily。</p><CopyBlock code={`curl -fsSL ${base}${P.paths.skillInstaller} | bash -s -- --dir ~/.claude/skills/maas-daily`} label="安装命令" /><p>更新时使用同一 --dir 重跑命令。安装器会校验完整包；发现未知文件时拒绝覆盖。</p><ol class="help-list"><li>确认最终目录顶层存在 SKILL.md。</li><li>开启新会话，再让 Agent 列出发现的 Skills。</li><li>查询失败时检查网络与服务状态，不用模型记忆补答。</li></ol><a href="/maas-skill/README.md">阅读完整安装说明 ↗</a></details>
        </section>

        <section class="method-panel" id="method-mcp" data-panel="mcp">
          <div class="panel-heading"><span class="eyebrow">远程工具连接</span><span class={`status ${P.surfaces.mcp.status}`}>{statusLabel(P.surfaces.mcp.status)}</span></div>
          <h2>把 MaaS Daily 加入你的工具列表</h2><p class="description">适合支持远程 Streamable HTTP MCP 的客户端。无需填写 token。</p>
          <div class="prompt-card"><div class="prompt-heading">服务器地址</div><CopyBlock code={`${base}${P.paths.mcpEndpoint}`} label="MCP 地址" /></div>
          <p class="after-copy">在客户端的 MCP 设置中添加远程服务器，保存后刷新工具列表或开启新会话。</p>
          <details class="advanced"><summary>使用 JSON 配置<span>＋</span></summary><CopyBlock code={mcpConfig} label="MCP 配置" /></details>
          <details class="advanced"><summary>Codex 的 TOML 配置<span>＋</span></summary><CopyBlock code={`[mcp_servers.maas-daily]\nurl = "${base}${P.paths.mcpEndpoint}"`} label="TOML 配置" /><p>配置示例供参考，Codex 的真实客户端验收仍待完成。</p></details>
          <div class="subsection"><h3>连接后，发一句验证</h3><CopyBlock code={verify} label="验证问题" /></div>
          <div class="tool-list">{[['maas_get_changes','平台变化'],['maas_get_prices','模型价格'],['maas_get_item','条目详情'],['maas_get_evidence','证据核验'],['maas_get_weekly','正式周报']].map(([name,use]) => <div><code>{name}</code><span>{use}</span></div>)}</div>
          <p class="after-copy">调用默认 10 条、最多 30 条；更多结果使用 cursor 翻页。遇到 429 按 Retry-After 等待，503 时稍后重试。</p>
        </section>

        <section class="method-panel" id="method-rss" data-panel="rss">
          <div class="panel-heading"><span class="eyebrow">订阅阅读</span><span class={`status ${P.surfaces.rss.status}`}>{statusLabel(P.surfaces.rss.status)}</span></div>
          <h2>更新来了，在阅读器里看</h2><p class="description">复制订阅地址，粘贴到阅读器的「添加订阅」中。</p>
          <div class="subsection"><h3>平台变化</h3><p>最近的平台变化与价格事件，最多 100 条。</p><CopyBlock code={`${base}${P.paths.feedChanges}`} label="变化订阅地址" /></div>
          <div class="subsection"><h3>正式周报</h3><p>按期阅读整理后的周报，最多 30 期。</p><CopyBlock code={`${base}${P.paths.feedWeekly}`} label="周报订阅地址" /></div>
          <p class="after-copy">{P.surfaces.rss.reason}</p><p class="after-copy">RSS 2.0，支持 ETag / 304。自动化轮询请间隔至少 30 分钟。详情页保留最新修订与撤回状态，阅读器内的旧条目可能不会同步撤回；订阅不包含第三方全文或再分发许可。</p>
        </section>

        <section class="method-panel" id="method-rest" data-panel="rest">
          <div class="panel-heading"><span class="eyebrow">开发者接入</span><span class={`status ${P.surfaces.rest.status}`}>{statusLabel(P.surfaces.rest.status)}</span></div>
          <h2>接入你的脚本与工作流</h2><p class="description">匿名 GET 请求，从一次真实查询开始。</p>
          <CopyBlock code={`curl "${base}${P.paths.apiBase}/changes?provider=openai&limit=5"`} label="查询命令" />
          <CopyBlock code={`curl ${base}${P.paths.apiBase}/status`} label="状态查询" />
          <div class="tool-list">{[['/status','数据版本与覆盖范围'],['/changes','平台变化'],['/prices','模型价格'],['/items/{id}','条目详情'],['/evidence/{id}','证据详情'],['/weekly','正式周报']].map(([path,use]) => <div><code>{P.paths.apiBase}{path}</code><span>{use}</span></div>)}</div>
          <p class="after-copy">列表默认 20 条、最多 100 条；翻页原样传回 cursor，过期后从第一页重查。支持 ETag / 304，错误返回 Problem JSON；429 按 Retry-After 等待。</p><a class="doc-link" href={P.paths.openapi}>查看 OpenAPI 完整定义 ↗</a>
        </section>
      </div>

      <aside class="access-aside">
        <section class="aside-section"><span class="eyebrow">你能获得什么</span><h3>回答有来源，<br />判断有依据。</h3><ul class="benefits"><li><b>平台变化</b><span>模型发布、API 更新与价格事件</span></li><li><b>价格事实</b><span>币种、计费单位、适用条件与证据</span></li><li><b>正式周报</b><span>按期查阅，回到原始记录</span></li></ul></section>
        <section class="aside-section" id="verify"><h3>怎样算接入成功？</h3><p>完成一次真实查询，回答带有数据截至日期、覆盖范围和站内链接；响应包含 datasetVersion。下载或保存配置只是第一步。</p></section>
        <section class="aside-section"><h3>接入资源</h3><a href="/llms.txt">给 Agent 的站点说明 <span>↗</span></a><a href="/maas-skill/README.md">Skill 安装文档 <span>↗</span></a><a href={P.paths.skillManifest}>Skill 文件清单 <span>↗</span></a><a href={P.paths.openapi}>OpenAPI 定义 <span>↗</span></a><a href={P.paths.changelog}>更新记录 <span>↗</span></a></section>
        <section class="aside-section client-status"><h3>客户端验证</h3>{P.verifiedClients.map(c => <p><strong>{c.name} · {c.surface.toUpperCase()} 已验证</strong><br />{c.version} · {c.verifiedAt}</p>)}{P.pendingClients.map(c => <p>{c.name} · 待验证</p>)}<p>服务已上线与客户端已验证是不同状态。</p></section>
      </aside>
    </div>
    <section class="data-note" id="boundary"><span class="eyebrow">关于这些数据</span><div><h3>观察快照，每次回答都带上时间</h3><p>数据截至 {release.dataThrough}，不代表供应商实时官网。未记录到匹配项，不等于外部世界没有变化；不同条件的价格需分别核对。详情页是修订与撤回状态的权威来源。</p><p class="coverage">数据版本 {release.datasetVersion.slice(0, 12)} · 变化覆盖 {release.coverage.changes.from} 至 {release.coverage.changes.to} · {release.coverage.changes.count} 条变化 · {release.coverage.prices.facts} 条价格事实</p><a href={P.paths.method}>了解数据方法与边界 ↗</a></div></section>
  </div>
</Layout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-method]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const activate = (key: string) => {
    links.forEach(link => { const active = link.dataset.method === key; link.setAttribute('aria-selected', String(active)); link.tabIndex = active ? 0 : -1; });
    panels.forEach(panel => { panel.hidden = panel.dataset.panel !== key; });
  };
  document.querySelector('.method-tabs')?.setAttribute('role', 'tablist');
  links.forEach((link, index) => {
    const key = link.dataset.method!;
    link.id = `tab-${key}`;
    link.setAttribute('role', 'tab');
    link.setAttribute('aria-controls', `method-${key}`);
    panels[index].setAttribute('role', 'tabpanel');
    panels[index].setAttribute('aria-labelledby', link.id);
    panels[index].tabIndex = 0;
    link.addEventListener('click', event => { event.preventDefault(); activate(key); history.replaceState(null, '', `#method-${key}`); });
    link.addEventListener('keydown', event => {
      let next = index;
      if (event.key === 'ArrowRight') next = (index + 1) % links.length;
      else if (event.key === 'ArrowLeft') next = (index - 1 + links.length) % links.length;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = links.length - 1;
      else return;
      event.preventDefault(); links[next].click(); links[next].focus();
    });
  });
  const syncHash = () => { const key = location.hash.replace('#method-', ''); activate(links.some(l => l.dataset.method === key) ? key : 'skill'); };
  syncHash(); window.addEventListener('hashchange', syncHash);
</script>

<style>
  .agent-page { padding:64px 0 0; }
  .agent-hero { padding-bottom:42px; }
  .kicker,.eyebrow { font-size:11px; letter-spacing:.12em; color:var(--acid); font-weight:600; }
  h1 { font-size:clamp(36px,4.2vw,56px); line-height:1.18; letter-spacing:-.055em; margin:18px 0 20px; }
  .intro { color:var(--paper-soft); font-size:16px; line-height:1.85; }
  .hero-meta { display:flex; flex-wrap:wrap; gap:10px 22px; margin-top:24px; font-size:12px; color:var(--muted); }
  .hero-meta span::before { content:'·'; color:var(--acid); margin-right:8px; }
  .access-layout { display:grid; grid-template-columns:minmax(0,1fr) 250px; gap:48px; align-items:start; }
  .access-main { min-width:0; }
  .method-tabs { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border-bottom:1px solid var(--line-strong); gap:8px; }
  .method-tabs a { padding:16px 12px; border-bottom:2px solid transparent; text-decoration:none; color:var(--muted); transition:background .2s,color .2s; }
  .method-tabs a:hover { background:var(--acid-dim); color:var(--paper); }
  .method-tabs a[aria-selected='true'] { border-color:var(--acid); color:var(--acid); background:var(--acid-dim); }
  .tab-top { display:flex; align-items:center; justify-content:space-between; gap:4px; font-size:15px; font-weight:600; }
  .tab-top small { font:10px ui-monospace,monospace; opacity:.65; }
  .tab-hint { display:block; font-size:11px; margin-top:6px; color:var(--muted); }
  .method-panel { padding:32px 0; scroll-margin-top:100px; }
  .panel-heading { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:12px; }
  .status { font-size:11px; color:var(--amber); }.status.available { color:var(--acid); }.status.unavailable { color:var(--red); }
  .status::before { content:'●'; font-size:7px; margin-right:6px; }
  h2 { font-size:27px; line-height:1.4; margin-bottom:9px; letter-spacing:-.03em; }
  .description { color:var(--muted); font-size:14px; }
  .quick-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; list-style:none; padding:26px 0; }
  .quick-steps li { display:flex; align-items:flex-start; gap:10px; font-size:12px; }
  .quick-steps b { font:12px ui-monospace,monospace; color:var(--acid); padding-top:5px; }
  .quick-steps small { display:block; font-size:10px; color:var(--muted); margin-top:4px; }
  .prompt-card { border:1px solid var(--line-strong); border-radius:12px; padding:20px 22px; background:var(--panel); }
  .prompt-heading { display:flex; justify-content:space-between; gap:10px; font-size:12px; font-weight:600; }
  .prompt-heading small { color:var(--muted); font-weight:400; font-size:11px; }
  .after-copy { font-size:12px; color:var(--muted); margin-top:12px; line-height:1.8; }
  .subsection { margin:30px 0 24px; }.subsection h3 { font-size:16px; margin-bottom:12px; }.subsection p { font-size:13px; color:var(--muted); }
  .question-list { border-top:1px solid var(--line); }
  details { border-bottom:1px solid var(--line); }
  summary { padding:15px 0; cursor:pointer; display:flex; justify-content:space-between; gap:15px; font-size:13px; list-style:none; }
  summary::-webkit-details-marker { display:none; }
  summary span { font-size:11px; color:var(--muted); }
  summary:hover { color:var(--acid); }
  details[open] { padding-bottom:16px; }details[open] summary { color:var(--acid); }
  .advanced p,.advanced li { font-size:12px; color:var(--paper-soft); margin-bottom:10px; }
  .advanced a,.doc-link { font-size:12px; color:var(--acid); }
  .help-list { padding-left:20px; }
  .tool-list { margin:24px 0; }.tool-list>div { display:flex; justify-content:space-between; gap:14px; padding:11px 0; border-bottom:1px solid var(--line); font-size:12px; }.tool-list span { color:var(--muted); }.tool-list code { overflow-wrap:anywhere; }
  .access-aside { border-left:1px solid var(--line); padding-left:28px; }
  .aside-section { margin-bottom:28px; }.aside-section h3 { font-size:15px; margin-bottom:12px; }.aside-section:first-child h3 { font-size:24px; line-height:1.45; margin-top:15px; }
  .aside-section p { font-size:12px; color:var(--muted); line-height:1.9; }
  .benefits { list-style:none; margin-top:22px; }.benefits li { margin-bottom:18px; }.benefits b { display:block; font-size:12px; font-weight:500; }.benefits span { color:var(--muted); font-size:11px; }
  .aside-section>a { display:flex; justify-content:space-between; padding:7px 0; font-size:12px; text-decoration:none; color:var(--paper-soft); }.aside-section>a:hover { color:var(--acid); }
  .client-status { border-top:1px solid var(--line); padding-top:22px; }.client-status p { margin-bottom:10px; }.client-status strong { font-weight:500; color:var(--paper-soft); }
  .data-note { display:grid; grid-template-columns:200px 1fr; gap:30px; border-top:1px solid var(--line-strong); margin-top:24px; padding-top:30px; }.data-note h3 { font-size:15px; margin-bottom:8px; }.data-note p { font-size:12px; color:var(--muted); max-width:760px; }.data-note a { display:inline-block; margin-top:12px; font-size:12px; color:var(--acid); }.coverage { margin-top:8px; }
  .agent-page :global(.copyblock) { margin:14px 0 0; }
  .agent-page :global(.copyblock-code) { background:var(--ink-2); border-color:var(--line); color:var(--paper-soft); padding:16px; font-size:12px; line-height:1.9; border-radius:7px; }
  .prompt-card :global(.copyblock-code) { background:transparent; border:0; padding:0 0 14px; font-family:inherit; font-size:13px; }
  .agent-page :global(.copyblock-btn) { background:var(--acid); color:var(--ink); min-height:40px; padding:8px 18px; font-size:12px; font-weight:600; transition:opacity .2s; }
  .agent-page :global(.copyblock-feedback.ok) { color:var(--acid); }.agent-page :global(.copyblock-feedback.err) { color:var(--red); }
  @media(max-width:1000px) { .access-layout { grid-template-columns:minmax(0,1fr) 210px; gap:28px; }.access-aside { padding-left:20px; }.tab-hint { font-size:10px; }.quick-steps { gap:10px; } }
  @media(max-width:760px) { .agent-page { padding-top:36px; }.agent-hero { padding-bottom:28px; }.access-layout { grid-template-columns:1fr; gap:16px; }.access-aside { border-left:0; border-top:1px solid var(--line); padding:28px 0 0; display:grid; grid-template-columns:1fr 1fr; gap:24px; }.aside-section { margin:0; }.client-status { border:0; padding:0; }.data-note { grid-template-columns:1fr; gap:12px; }.tab-top { font-size:13px; }.tab-top small { display:none; }.method-tabs a { padding:12px 8px; } }
  @media(max-width:480px) { .intro { font-size:14px; }.desktop-break { display:none; }h2 { font-size:23px; }.quick-steps { grid-template-columns:1fr; gap:14px; }.quick-steps small { display:inline; margin-left:9px; }.quick-steps b { min-width:18px; }.tab-hint { display:none; }.prompt-card { padding:16px; }.prompt-heading small { font-size:10px; }.access-aside { grid-template-columns:1fr; }.tool-list>div { font-size:11px; }.hero-meta { gap:8px 14px; } }
  @media(prefers-reduced-motion:reduce) { .method-tabs a,.agent-page :global(.copyblock-btn) { transition:none; } }
</style>
