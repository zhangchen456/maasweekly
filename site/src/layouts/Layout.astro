---
import '../styles/product.css';
import '../styles/spec-sheet.css';
import BrandLogo from '../components/BrandLogo.astro';
import AccountAccess from '../components/AccountAccess.astro';
import analytics from '../config/analytics.json';
import { validateAnalyticsConfig } from '../../public/analytics.js';
import { SITE_CANONICAL } from '../config/public-access';
import { canonicalUrl } from '../lib/seo';
import { languageRoute } from '../lib/locales';
import { englishHtml, englishUi } from '../lib/ui-translation';
validateAnalyticsConfig(analytics);
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  locale?: 'zh' | 'en';
}

const activePath = Astro.url.pathname;
const { title, description = "全球 MaaS 平台每日追踪 — 模型发布、定价变更、API 更新", noindex = false } = Astro.props;
const locale = Astro.props.locale ?? (activePath.startsWith('/en/') ? 'en' : 'zh');
const en = locale === 'en';
const t = (zh: string, english: string) => en ? english : zh;
const zhRoute = languageRoute(activePath, 'zh');
const enRoute = languageRoute(activePath, 'en');
const canonical = canonicalUrl(Astro.url.pathname);
const content = await Astro.slots.render('default');
const localizedContent = en ? englishHtml(content) : content;
---

<!doctype html>
<html lang={en ? "en" : "zh-CN"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=transparent-3" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=transparent-3" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=transparent-3" />
    <link rel="shortcut icon" href="/favicon.ico?v=transparent-3" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=transparent-3" />
    <link rel="manifest" href="/site.webmanifest?v=transparent-3" />
    <meta name="theme-color" content="#172724" />
    <meta name="apple-mobile-web-app-title" content="MaaS Daily" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={en ? englishUi(description) : description} />
    {activePath === '/' && <meta name="baidu-site-verification" content="codeva-UXsh2qWgbK" />}
    <title>{en ? englishUi(title) : title}</title>
    <link rel="canonical" href={canonical} />
    {zhRoute && enRoute && <><link rel="alternate" hreflang="zh-CN" href={canonicalUrl(zhRoute)} /><link rel="alternate" hreflang="en" href={canonicalUrl(enRoute)} /></>}
    <script is:inline type="module" src="/language.js"></script>
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={en ? englishUi(title) : title} />
    <meta property="og:description" content={en ? englishUi(description) : description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MaaS Daily" />
    <meta property="og:image" content={`${SITE_CANONICAL}/brand/social-card.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="MaaS Daily — model and price intelligence" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${SITE_CANONICAL}/brand/social-card.png`} />
    {analytics.enabled && (
      <script is:inline type="module" src="/analytics.js" data-maas-analytics
        data-website-id={analytics.websiteId} data-canonical-url={SITE_CANONICAL}></script>
    )}
    <script is:inline>
      (function () {
        let saved; try { saved = localStorage.getItem('maas-theme'); } catch {}
        if (saved !== 'dark') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body class="spec-sheet">
    <a class="skip-link" href="#main-content">{t("跳到内容", "Skip to content")}</a>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a href={en ? "/en/" : "/?lang=zh"} class="brand" aria-label="MaaS Daily"><BrandLogo /></a>
        <nav class="nav" aria-label={t('页面导航', 'Main navigation')}>
          {[['/', t('今日', 'Today')], ['/leaderboards/', t('榜单', 'Rankings')], ['/pricing/', t('价格', 'Prices')], ['/changes/', t('变化', 'Changes')], ['/sources/', t('信源', 'Sources')], ['/weekly/', t('归档', 'Archive')], ['/agent/', t('接入', 'Connect')], ['/subscription/', t('订阅', 'Plans')]].map(([href, label]) => <a href={href === '/pro/' ? href : en ? `/en${href}` : href === '/' ? '/?lang=zh' : href} aria-current={activePath.replace(/^\/en/, '') === href.split('?')[0] ? 'page' : undefined}>{label}</a>)}
        </nav>
        <nav class="language-switch" aria-label={t('语言', 'Language')}>
          <a href={zhRoute === '/' ? '/?lang=zh' : zhRoute ?? '/?lang=zh&untranslated=1'} data-language="zh" data-translated={Boolean(zhRoute)} lang="zh-CN" aria-current={!en ? 'true' : undefined}>中文</a>
          <span aria-hidden="true"> / </span>
          <a href={enRoute ?? '/en/?lang=en&untranslated=1'} data-language="en" data-translated={Boolean(enRoute)} lang="en" aria-current={en ? 'true' : undefined}>English</a>
        </nav>
        <button class="theme-toggle" aria-label={t("切换主题", "Switch theme")} title={t("切换深/浅色", "Switch dark/light theme")}>
          <span class="theme-icon-light">☀</span>
          <span class="theme-icon-dark">☾</span>
        </button>
        <AccountAccess locale={locale} />
      </div>
    </header>
    <main id="main-content">
      <div class="shell">
        <p id="language-note" role="status" hidden></p>
        <Fragment set:html={localizedContent} />
      </div>
    </main>
    <footer>
      <div class="shell footer-inner">
        <div><div class="footer-title">MaaS Daily Intelligence</div><div>{t("模型 × 平台 × 价格 × 生态", "Models × Platforms × Prices × Ecosystem")}</div></div>
        <div class="footer-meta">
          <p class="time-zone-note">{t("精确时间按浏览器时区显示：", "Timestamps use your browser time zone: ")}<span data-browser-timezone>UTC</span>{t("；日期精度记录保留原日期。", "; date-only records retain their original date.")}</p>
          <a href={en ? '/en/about/' : '/about/'}>{t('关于', 'About')}</a> · <a href={en ? '/en/changelog/' : '/changelog/'}>{t('变更', 'Changelog')}</a> · <a href={en ? '/en/models/' : '/models/'}>{t('模型价格', 'Model prices')}</a> · <a href={en ? '/en/guides/' : '/guides/'}>{t('成本指南', 'Cost guides')}</a> · <a href={en ? '/en/agent/' : '/agent/'}>{t('接入', 'Connect')}</a> · <a href={en ? '/en/method/' : '/method/'}>{t('方法', 'Method')}</a> · <a href={en ? "/en/feedback/" : "/feedback/"}>{t("反馈问题", "Report a problem")}</a> · <a href="mailto:zhangchen3508@gmail.com" class="contact-link">{t("联系我", "Contact me")} · zhangchen3508@gmail.com</a> · <a href="/feed.xml">RSS {en && '(Chinese)'}</a>

        </div>
      </div>
    </footer>

    <script>import '../scripts/account-preferences'; import '../scripts/ui-translation'; import { startTimeDisplay } from '../../public/time-display.js'; startTimeDisplay(window);</script>
    <script is:inline>
      document.querySelector('.theme-toggle')?.addEventListener('click', () => {
        const cur = document.documentElement.getAttribute('data-theme');
        const next = cur === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        try { localStorage.setItem('maas-theme', next); } catch {}
        document.dispatchEvent(new CustomEvent('maas:theme-change', { detail: next }));
      });
      document.documentElement.classList.add('motion-ready');
      // reveal 动画
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            revealObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.08 });
      document.querySelectorAll('.reveal').forEach((el) => revealObserver.observe(el));
    </script>

    <style is:global>
      .time-zone-note { font-size: 12px; color: var(--muted); line-height: 1.6; overflow-wrap: anywhere; }
      .language-switch { white-space: nowrap; font-size: 12px; }
      .language-switch a { color: var(--paper); padding: 8px 2px; }
      .language-switch a[aria-current] { color: var(--acid); }
      .topbar-inner { flex-wrap: wrap; }
      #language-note { padding: 14px; border: 1px solid var(--line); }
      /* ===== 深色主题(默认,墨绿黑) ===== */
      :root,
      [data-theme="dark"] {
        --ink: #07110f;
        --ink-2: #0b1916;
        --panel: rgba(14, 31, 27, .78);
        --panel-solid: #0e1f1b;
        --line: rgba(190, 224, 211, .16);
        --line-strong: rgba(190, 224, 211, .3);
        --paper: #dbe7e1;
        --paper-soft: #b7c9c1;
        --muted: #8fa69c;
        --acid: #b8f23f;
        --acid-dim: rgba(184, 242, 63, .13);
        --red: #ff684f;
        --red-dim: rgba(255, 104, 79, .12);
        --amber: #f5c76b;
        --amber-dim: rgba(245, 199, 107, .12);
        --cyan: #78d6cb;
        --shadow: 0 28px 90px rgba(0, 0, 0, .34);
        --radius: 22px;
        --bg-grad: radial-gradient(circle at 14% 8%, rgba(120, 214, 203, .09), transparent 29rem),
                   radial-gradient(circle at 88% 21%, rgba(184, 242, 63, .07), transparent 31rem),
                   linear-gradient(180deg, #06100e 0%, #091512 55%, #06100e 100%);
        --noise-opacity: .16;
      }

      /* ===== 浅色主题(纸张暖白) ===== */
      [data-theme="light"] {
        --ink: #f4f4f0;
        --ink-2: #ecebe6;
        --panel: rgba(255, 255, 255, .82);
        --panel-solid: #ffffff;
        --line: rgba(7, 17, 15, .12);
        --line-strong: rgba(7, 17, 15, .22);
        --paper: #1a1a1a;
        --paper-soft: #3a3a3a;
        --muted: #6a6a62;
        --acid: #2d7a2d;
        --acid-dim: rgba(45, 122, 45, .1);
        --red: #d11414;
        --red-dim: rgba(209, 20, 20, .08);
        --amber: #8a6d00;
        --amber-dim: rgba(138, 109, 0, .08);
        --cyan: #1f6c9f;
        --shadow: 0 20px 60px rgba(0, 0, 0, .08);
        --radius: 22px;
        --bg-grad: radial-gradient(circle at 14% 8%, rgba(45, 122, 45, .04), transparent 29rem),
                   radial-gradient(circle at 88% 21%, rgba(184, 242, 63, .06), transparent 31rem),
                   linear-gradient(180deg, #f4f4f0 0%, #ecebe6 55%, #f4f4f0 100%);
        --noise-opacity: .06;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; overflow-x: hidden; }
      body {
        color: var(--paper);
        background: var(--bg-grad);
        background-attachment: fixed;
        font: 15px/1.75 "PingFang SC", "Microsoft YaHei", -apple-system, sans-serif;
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }
      body::before {
        content: "";
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: var(--noise-opacity);
        z-index: 20;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
      }
      ::selection { color: var(--ink); background: var(--acid); }
      a { color: inherit; }

      .shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; }

      /* 顶栏 */
      .topbar {
        position: sticky; top: 0; z-index: 100;
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        background: color-mix(in srgb, var(--ink) 74%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .topbar-inner {
        min-height: 58px;
        display: flex; align-items: center; justify-content: space-between; gap: 18px;
      }
      .brand { display: flex; align-items: center; gap: 11px; font: 700 12px/1 "SF Mono", "JetBrains Mono", monospace; letter-spacing: .12em; text-decoration: none; color: var(--paper); }
      .nav { display: flex; gap: 24px; color: var(--muted); font-size: 12px; }
      .nav a { text-decoration: none; transition: color .2s ease; }
      .nav a:hover { color: var(--paper); }
      .theme-toggle {
        appearance: none; border: 1px solid var(--line-strong); color: var(--paper);
        background: transparent; border-radius: 99px; width: 32px; height: 32px;
        display: flex; align-items: center; justify-content: center; cursor: pointer;
        font-size: 14px; transition: .2s ease;
      }
      .theme-toggle:hover { color: var(--ink); background: var(--acid); border-color: var(--acid); }
      [data-theme="light"] .theme-icon-dark { display: none; }
      [data-theme="dark"] .theme-icon-light { display: none; }

      main { padding-bottom: 60px; }
      section { scroll-margin-top: 84px; }

      /* 排版 */
      h1, h2, h3, .display { font-family: "Songti SC", "STSong", "Noto Serif CJK SC", Georgia, serif; font-weight: 700; letter-spacing: -.035em; }
      .mono { font-family: "SF Mono", "JetBrains Mono", "Cascadia Mono", monospace; }

      /* 分区标题 */
      .section { margin-top: 100px; }
      .section-heading { display: grid; grid-template-columns: 110px 1fr; gap: 24px; align-items: baseline; margin-bottom: 38px; }
      .section-no { color: var(--acid); font: 700 12px/1 "SF Mono", monospace; letter-spacing: .12em; }
      .section h2 { font-size: clamp(32px, 4.5vw, 54px); line-height: 1.04; letter-spacing: -.045em; }
      .section-note { grid-column: 2; margin: -12px 0 0; color: var(--muted); max-width: 680px; font-size: 14px; }

      /* 共享:状态点 */
      .status { display: inline-flex; align-items: center; gap: 8px; color: var(--paper-soft); white-space: nowrap; font-size: 13px; }
      .status::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--amber); box-shadow: 0 0 0 4px var(--amber-dim); }
      .status.active::before { background: var(--acid); box-shadow: 0 0 0 4px var(--acid-dim); }
      .status.critical::before { background: var(--red); box-shadow: 0 0 0 4px var(--red-dim); }

      /* 价格 chip */
      .price-chip { padding: 6px 11px; border-radius: 8px; background: var(--red-dim); color: var(--red); font: 700 11px/1.35 "SF Mono", monospace; display: inline-block; }
      .price-chip.amber { background: var(--amber-dim); color: var(--amber); }
      .price-chip.acid { background: var(--acid-dim); color: var(--acid); }

      /* reveal 动画 */
      .reveal { opacity: 1; transform: none; }
      .motion-ready .reveal:not(.in) { opacity: 0; transform: translateY(22px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.75,.25,1); }
      .reveal.in { opacity: 1; transform: none; }

      /* footer */
      footer { padding: 36px 0 50px; border-top: 1px solid var(--line); color: var(--muted); margin-top: 60px; }
      .footer-inner { display: flex; justify-content: space-between; gap: 30px; align-items: end; }
      .footer-title { color: var(--paper); font: 700 17px/1 "Songti SC", serif; }
      .contact-link{overflow-wrap:anywhere}.footer-meta { text-align: right; font: 10px/1.8 "SF Mono", monospace; letter-spacing: .06em; }
      .footer-meta a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
      @media (max-width: 480px) {
        .nav { gap: 14px; flex-wrap: wrap; }
      }

      /* prose markdown */
      .prose h1 { font-size: 1.6em; margin: 1.2em 0 .5em; font-family: "Songti SC", serif; }
      .prose h2 { font-size: 1.3em; margin: 1.4em 0 .4em; font-family: "Songti SC", serif; }
      .prose h3 { font-size: 1.1em; margin: 1.2em 0 .3em; }
      .prose p { margin: .6em 0; }
      .prose ul, .prose ol { margin: .6em 0; padding-left: 1.3em; }
      .prose li { margin: .2em 0; }
      .prose code { background: var(--ink-2); padding: 1px 5px; border-radius: 4px; font-size: .85em; font-family: "SF Mono", monospace; }
      .prose pre { background: var(--ink-2); border: 1px solid var(--line); border-radius: 8px; padding: 14px; overflow-x: auto; margin: 1em 0; }
      .prose pre code { background: none; padding: 0; }
      .prose blockquote { border-left: 2px solid var(--acid); padding-left: 14px; margin: 1em 0; color: var(--muted); }
      .prose strong { font-weight: 700; }
      .prose hr { border: none; border-top: 1px solid var(--line); margin: 2em 0; }
      .prose table { width: 100%; border-collapse: collapse; margin: 1em 0; font-size: 13px; }
      .prose th, .prose td { border: 1px solid var(--line); padding: 8px 10px; text-align: left; }
      .prose th { background: var(--ink-2); font-weight: 700; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }

      @media (max-width: 900px) {
        .topbar-inner { flex-wrap: wrap; gap: 12px; padding-top: 16px; }
        .nav { order: 3; width: 100%; justify-content: space-between; padding-bottom: 12px; }
        .section-heading { grid-template-columns: 54px 1fr; gap: 10px; }
        .section-note { grid-column: 1 / -1; margin-top: 6px; }
        .section { margin-top: 70px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; animation: none !important; transition: none !important; }
        .motion-ready .reveal:not(.in) { opacity: 1; transform: none; }
      }
    </style>
  </body>
</html>
