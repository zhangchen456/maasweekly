{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daily.maas.click/schemas/public-v1/weekly.schema.json",
  "title": "正式周报实体（仅 site/src/content/weekly 契约条目，滚动摘要不混入）",
  "type": "object",
  "required": ["id", "title", "date", "url", "headline", "platforms", "trends", "watchpoints", "eventIndex"],
  "properties": {
    "id": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "发布日期（文件名）"},
    "title": {"type": "string"},
    "date": {"$ref": "common.schema.json#/$defs/calendarDate"},
    "period": {"type": ["string", "null"], "description": "如 2026-08-25 ~ 2026-09-01"},
    "url": {"type": "string", "pattern": "^/weekly/[^/]+/$"},
    "headline": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rank": {"type": "integer"},
          "level": {"type": ["string", "null"]},
          "platform": {"type": ["string", "null"]},
          "title": {"type": ["string", "null"]},
          "summary": {"type": ["string", "null"]},
          "detail_markdown": {"type": ["string", "null"]},
          "date_mentioned": {"type": ["string", "null"]},
          "is_new": {"type": ["boolean", "null"]}
        },
        "additionalProperties": false
      }
    },
    "platforms": {"type": "array"},
    "summary_table": {"type": ["array", "null"]},
    "trends": {"type": "array"},
    "watchpoints": {"type": ["array", "null"]},
    "event_index": {"type": ["array", "null"]}
  },
  "additionalProperties": false
}
