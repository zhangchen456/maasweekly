# Candidate service. No timer, automatic publication or mail delivery.
[Unit]
Description=MaaS Daily editorial worker
After=network.target
[Service]
Type=simple
User=maasagent
Group=maasagent
WorkingDirectory=/srv/maasweekly/current/agent-api
EnvironmentFile=/srv/maasweekly/shared/agent.env
EnvironmentFile=/srv/maasweekly/shared/editorial.env
ExecStart=/usr/bin/node --preserve-symlinks-main /srv/maasweekly/current/agent-api/dist/editorial-worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=210
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/maasweekly/shared/state
[Install]
WantedBy=multi-user.target
