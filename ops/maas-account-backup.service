[Unit]
Description=MaaS Daily account backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=maasagent
Group=maasagent
EnvironmentFile=/srv/maasweekly/shared/agent.env
EnvironmentFile=-/srv/maasweekly/shared/account-operations.env
ExecStart=/usr/bin/python3 /usr/local/lib/maasweekly/account-maintenance.py backup
TimeoutStartSec=10min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/maasweekly/shared/state
CapabilityBoundingSet=
AmbientCapabilities=
