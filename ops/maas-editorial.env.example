# Candidate only: share account database and secret with API; never install automatically.
# MAAS_ACCOUNT_DB is loaded from the original agent.env (shared/state/accounts).
# MAAS_ACCOUNT_SECRET is loaded from the original protected agent.env, never copied here.
PUBLIC_DATA_ROOT=/srv/maasweekly/current/data/public/v1
MAAS_EDITORIAL_CONFIG=/srv/maasweekly/shared/editorial-model.json
# Default off. Enable only after separate paid provider/budget approval.
MAAS_EDITORIAL_ALLOW_PAID=false
# OPENAI_API_KEY belongs only in protected environment configuration.
