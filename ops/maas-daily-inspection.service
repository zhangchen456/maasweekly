[Unit]
Description=MaaS Daily resources, services and public links inspection mail
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=maasagent
Group=maasagent
EnvironmentFile=/srv/maasweekly/shared/data-alert.env
ExecStart=/usr/bin/python3 -B /usr/local/lib/maasweekly/daily_inspection.py --send
TimeoutStartSec=20min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/maasweekly/shared/state/data-alerts
CapabilityBoundingSet=
AmbientCapabilities=
