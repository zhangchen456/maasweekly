# maas-agent.env.example：agent-api 生产环境变量样例（Task 06 M7 候选）
#
# 真实文件安装到 /srv/maasweekly/shared/agent.env（root:maasagent 0740，
# 由 install-production.sh 生成；本文件只含变量名与安全默认值，无真实 secret）。
#
# 槽位专属变量（PORT/PUBLIC_DATA_ROOT/MAAS_RELEASE_DIR）不在本文件——
# 由 maasweekly-activate 写入 shared/slots/<slot>.env（蓝绿切换时更新）。

# ---- 绑定（永不监听公网；TLS 由 nginx 终结） ----
HOST=127.0.0.1

# ---- 数据根（只读当前候选 release 的公开投影） ----
# 注意：会被 slots/<slot>.env 中的 PUBLIC_DATA_ROOT 覆盖（槽位 env 后加载）
# PUBLIC_DATA_ROOT=/srv/maasweekly/current/data/public/v1

# ---- 热重载 ----
# 不可变 release 槽位关闭轮询；SIGHUP 强制重新校验 hash。
# 本地可变数据根可设 30000；同版本只检查 manifest。
RELOAD_INTERVAL_MS=0
RETAINED_DATASET_MAX_VERSIONS=2
# 历史缓存按 manifest 原始字节预算；不是 RSS 上限。
RETAINED_DATASET_MAX_BYTES=134217728
# 仅在审核安装的 nginx 对 REST/MCP 覆盖 X-Maas-Client-IP 后启用。
MAAS_TRUST_LOOPBACK_PROXY=0

# ---- REST 每 IP 限流（NAT 共享；最多10000桶，闲置5分钟淘汰） ----
RATE_CAPACITY=60
RATE_REFILL_PER_MIN=30
RATE_GLOBAL_CAPACITY=6000
RATE_GLOBAL_REFILL_PER_MIN=3000

# ---- MCP 独立限流（不消耗 REST 桶） ----
MCP_RATE_CAPACITY=30
MCP_RATE_REFILL_PER_MIN=30
MCP_RATE_GLOBAL_CAPACITY=3000
MCP_RATE_GLOBAL_REFILL_PER_MIN=3000
# 与 nginx client_max_body_size 保持一致
MCP_MAX_BODY_BYTES=262144

# ---- MCP Origin 白名单（逗号分隔；空=缺省 Origin 客户端可用，有 Origin 时校验） ----
MCP_ALLOWED_ORIGINS=

# ---- cursor MAC 密钥（root 管理，多槽位共享同一值；轮换会使在途 cursor 失效） ----
# 生成：openssl rand -hex 32
CURSOR_SECRET=<root 生成，48-64 hex，不入仓库>

# Internal bounded JSONL diagnostics to stdout/journald; 0 disables collection.
MAAS_DIAGNOSTICS=1

# ---- Account/watch v1 (disabled until MAAS_ACCOUNT_DB is configured) ----
MAAS_ACCOUNT_ORIGIN=https://daily.maas.click
# MAAS_ACCOUNT_DB=/srv/maasweekly/shared/state/accounts.sqlite
# MAAS_ACCOUNT_SECRET=<random 32+ characters; generate locally, never commit>
# RESEND_API_KEY=<secret>
# MAAS_MAIL_FROM=MaaS Daily <notifications@your-verified-domain>
# Local development only: MAAS_MAIL_MODE=outbox; MAAS_MAIL_OUTBOX=<private path>
