# maas-agent.env.example：agent-api 生产环境变量样例（Task 06 M7 候选）
#
# 真实文件安装到 /srv/maasweekly/shared/agent.env（root:maasagent 0740，
# 由 install-production.sh 生成；本文件只含变量名与安全默认值，无真实 secret）。
#
# 槽位专属变量（PORT/PUBLIC_DATA_ROOT/MAAS_RELEASE_DIR）不在本文件——
# 由 maasweekly-activate 写入 shared/slots/<slot>.env（蓝绿切换时更新）。

# ---- 绑定（永不监听公网；TLS 由 nginx 终结） ----
HOST=127.0.0.1

# ---- 数据根（只读当前候选 release 的公开投影） ----
# 注意：会被 slots/<slot>.env 中的 PUBLIC_DATA_ROOT 覆盖（槽位 env 后加载）
# PUBLIC_DATA_ROOT=/srv/maasweekly/current/data/public/v1

# ---- 热重载 ----
# 30s 轮询 manifest；0=禁用（只 SIGHUP）
RELOAD_INTERVAL_MS=30000

# ---- REST 限流（匿名令牌桶） ----
RATE_CAPACITY=60
RATE_REFILL_PER_MIN=30

# ---- MCP 独立限流（不消耗 REST 桶） ----
MCP_RATE_CAPACITY=30
MCP_RATE_REFILL_PER_MIN=30
# 与 nginx client_max_body_size 保持一致
MCP_MAX_BODY_BYTES=262144

# ---- MCP Origin 白名单（逗号分隔；空=缺省 Origin 客户端可用，有 Origin 时校验） ----
MCP_ALLOWED_ORIGINS=

# ---- cursor MAC 密钥（root 管理，多槽位共享同一值；轮换会使在途 cursor 失效） ----
# 生成：openssl rand -hex 32
CURSOR_SECRET=<root 生成，48-64 hex，不入仓库>
